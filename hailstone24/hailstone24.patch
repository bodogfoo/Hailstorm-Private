+
+print('DECOY_BLOCKED_AND_EMPTY_SAFE_OK')
+)lua");
+
+    std::string why;
+    REQUIRE(h.host->run("rgmercs", {}, &why));
+    for (int i = 0; i < 32 && h.host->running("rgmercs"); ++i) {
+        h.now_ms += 10;
+        h.host->pulse();
+    }
+
+    CHECK(h.host->list().empty());
+    const auto outcome = h.host->last_outcome("rgmercs");
+    REQUIRE(outcome.has_value());
+    CHECK(outcome->status == "EXITED");
