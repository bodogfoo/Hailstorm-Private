+int luaopen_actors(lua_State* L) {
+    static const luaL_Reg kFuncs[] = {
+        {"register", l_actors_register},
+        {"send", l_actors_send},
+        {nullptr, nullptr},
+    };
+    luaL_newlib(L, kFuncs);
+    return 1;
+}
