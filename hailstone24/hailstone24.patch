+std::vector<std::string> split(const std::string& line) {
+    std::vector<std::string> out;
+    std::string f;
+    for (char c : line) {
+        if (c == '^') {
+            out.push_back(f);
+            f.clear();
+        } else if (c != '\r' && c != '\n') {
+            f += c;
+        }
+    }
+    out.push_back(f);
+    return out;
