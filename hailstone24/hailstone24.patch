+
+local encoded = json_mod.encode({ char = "Noro's Son", hp = 95, ok = true })
+local decoded = json_mod.decode(encoded)
+assert(decoded.char == "Noro's Son" and decoded.hp == 95 and decoded.ok == true)
+
+hailstone.rgmercs.set_status('PackageMan OK')
+if tonumber(hailstone.rgmercs.get_setting('FailNow')) == 1 then
+    error('intentional class init failure')
+end
+mq.delay(25)
+print('LIFECYCLE_OK')
+)lua");
+
+    // 1. Trigger an error and confirm error state is preserved (NOT overwritten by "stopped").
+    CHECK(h.bridge.set_setting("FailNow", "1", "Class", false));
+    std::string why;
+    REQUIRE(h.host->run("rgmercs", {}, &why));
+    for (int i = 0; i < 16 && h.host->running("rgmercs"); ++i) {
+        h.now_ms += 10;
+        h.host->pulse();
+    }
+    const auto err_snap = h.bridge.snapshot();
+    CHECK(err_snap.script_status == "error");
+    CHECK(err_snap.error_count >= 1);
+    CHECK(err_snap.last_error.find("intentional class init failure") != std::string::npos);
+
+    const auto outcome = h.host->last_outcome("rgmercs");
+    REQUIRE(outcome.has_value());
+    CHECK(outcome->status == "ERROR");
+    CHECK(outcome->error.find("intentional class init failure") != std::string::npos);
+
+    // Even if stop() is called after error, bridge does not silently clobber the error banner until reload/clear.
+    h.host->stop("rgmercs");
+    CHECK(h.bridge.snapshot().script_status == "error");
+
+    // 2. Fix setting and call reload() -> transitions cleanly to running and completes without error.
+    CHECK(h.bridge.set_setting("FailNow", "0", "Class", false));
+    REQUIRE(h.host->reload("rgmercs", {}, &why));
+    CHECK(h.bridge.snapshot().script_status == "running");
+    for (int i = 0; i < 16 && h.host->running("rgmercs"); ++i) {
+        h.now_ms += 10;
+        h.host->pulse();
+    }
+    CHECK(h.has_line("LIFECYCLE_OK"));
+    const auto ok_snap = h.bridge.snapshot();
+    CHECK(ok_snap.last_error.empty());
+    CHECK(ok_snap.script_status == "stopped");
+    CHECK(ok_snap.transitions.size() >= 3);
+}
