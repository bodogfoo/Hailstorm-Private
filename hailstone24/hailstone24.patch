+    local hi = math.floor(e.max_val or 100)
+    if hi <= lo then hi = lo + 100 end
+    if (hi - lo) <= 1000 then
+      local nxt, changed = ui.SliderInt("##v", cur, lo, hi)
+      if changed then
+        API.rgmercs.SetSetting(e.key, tostring(math.floor(nxt)), e.category)
+      end
