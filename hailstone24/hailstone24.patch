+    if (!gp.id.empty()) {
+        active_group_profile_ = gp;
+        startup_group_applied_ = true;
+        opts_.profile = st.profile;
+        opts_.slot = st.slot;
+        opts_.server = st.server;
+        opts_.login_launch.world = st.world;
