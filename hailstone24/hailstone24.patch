+        if (!configured.empty()) {
+            if (auto path = core::find_group_profile_file(platform::profiles_dir(), configured)) {
+                core::GroupProfile gp;
+                if (core::load_group_profile(*path, gp)) active_group_profile_ = std::move(gp);
