+-- Direct attempts to load executable code from scripts/config/ MUST fail in data-only sandbox and never run!
+local bad1, e1 = loadfile(mq.configDir .. '/rgmercs/class_configs/Live/rog_class_config.lua')
+assert(bad1 == nil and (tostring(e1):find('not data', 1, true) ~= nil or tostring(e1):find('nil value', 1, true) ~= nil), tostring(e1))
+local bad2, e2 = loadfile('scripts/config/rgmercs/class_configs/Live/rog_class_config.lua')
+assert(bad2 == nil and (tostring(e2):find('cannot open', 1, true) ~= nil or tostring(e2):find('not data', 1, true) ~= nil or tostring(e2):find('nil value', 1, true) ~= nil), tostring(e2))
+local bad3, e3 = loadfile('config/rgmercs/settings_decoy.lua')
+assert(bad3 == nil and (tostring(e3):find('cannot open', 1, true) ~= nil or tostring(e3):find('not data', 1, true) ~= nil), tostring(e3))
+local bad4, e4 = loadfile('rgmercs/settings_decoy.lua')
+assert(bad4 == nil and tostring(e4):find('not data', 1, true) ~= nil, tostring(e4))
