+        while (end < trimmed.size() && !std::isspace(static_cast<unsigned char>(trimmed[end]))) ++end;
+        if (!contains_ci(server.name, trimmed.substr(pos, end - pos))) return false;
+        pos = end;
+    }
+    return true;
