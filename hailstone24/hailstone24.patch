+int luaopen_lfs(lua_State* L) {
+    static const luaL_Reg kFuncs[] = {
+        {"attributes", l_lfs_attributes},
+        {"symlinkattributes", l_lfs_attributes},
+        {"dir", l_lfs_dir},
+        {"mkdir", l_lfs_mkdir},
+        {"rmdir", l_lfs_rmdir},
+        {"currentdir", l_lfs_currentdir},
+        {"chdir", l_lfs_chdir},
