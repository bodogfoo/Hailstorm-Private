+TEST_CASE("RG Mercs compatibility: TLOs, Lua compat modules (lsqlite3/lfs/actors/bit32), and IPC commands") {
+    mq_test::World world{"hailstone_rgmercs_test"};
+    const fs::path lua_dir = world.dir / "lua";
+    const fs::path cfg_dir = world.dir / "config";
+    fs::create_directories(lua_dir);
+    fs::create_directories(cfg_dir);
+
+    const fs::path src_script = fs::path(HAILSTONE_SOURCE_DIR) / "tests/hailstone24/rgmercs_validation.lua";
+    REQUIRE(fs::exists(src_script));
+    fs::copy_file(src_script, lua_dir / "rgmercs_validation.lua", fs::copy_options::overwrite_existing);
+
+#if !defined(_WIN32)
+    ipc::SessionBusServer bus_server;
+    const std::string sock = (world.dir / "rg_bus.sock").string();
+    REQUIRE(bus_server.start(sock));
+
+    ipc::SessionBusClient client_self, client_peer;
+    REQUIRE(client_self.connect(sock, "slot01"));
+    REQUIRE(client_peer.connect(sock, "slot02"));
+#endif
+
+    plugin::Hooks hooks;
+    plugin::Policy policy;
+    plugin::Rules rules;
+    rules.configured = true;
+    rules.player_script_caps = plugin::kCapAll;
+    rules.social_mode = plugin::ButtonMode::Off;
+    policy.set(rules);
+
+    mq::Registry reg;
+    mq::register_game_tlos(reg);
+
+    mq::Context ctx;
+    ctx.registry = &reg;
+    ctx.conn = world.conn.get();
+    ctx.server_name = "TestServer";
+    ctx.lua_dir = lua_dir.string();
+    ctx.active_script = "rgmercs_validation";
+    ctx.foreground = true;
+#if !defined(_WIN32)
+    ctx.ipc_bus = &client_self;
+#endif
+
+    std::vector<std::string> printed;
+    std::vector<std::string> dispatched_peer_cmds;
+#if !defined(_WIN32)
+    client_peer.set_on_command([&](const ipc::CommandPacket& cmd) {
+        dispatched_peer_cmds.push_back(cmd.command);
+        return ipc::CommandAckPacket{cmd.seq, "slot02", true, "ok"};
+    });
+    ipc::SessionSnapshot snap1;
+    snap1.session_id = "slot01";
+    snap1.character_name = "Tester";
+    snap1.server_name = "TestServer";
+    snap1.class_short = "CLR";
+    snap1.zone_short = "qeynos2";
+    snap1.group_leader = "Groupie";
+    snap1.exec_state = app::ExecutionState::ForegroundFull;
+    client_self.publish_telemetry(snap1);
+
+    ipc::SessionSnapshot snap2;
+    snap2.session_id = "slot02";
+    snap2.character_name = "Groupie";
+    snap2.server_name = "TestServer";
+    snap2.class_short = "WAR";
+    snap2.zone_short = "qeynos2";
+    snap2.group_leader = "Groupie";
+    snap2.exec_state = app::ExecutionState::BackgroundHeadless;
+    client_peer.publish_telemetry(snap2);
+#endif
+
+    mq::CommandEnv ce;
+    ce.hooks = &hooks;
+    ce.registry = &reg;
+    ce.context = [&]() -> const mq::Context& { return ctx; };
+    ce.echo = [&](const std::string& s) { printed.push_back(s); };
+    ce.run = [&](const std::string& line) {
+        std::string l = line;
+        (void)hooks.command(l);
+    };
+#if !defined(_WIN32)
+    ce.ipc_bus = &client_self;
+#endif
+    mq::Commands commands(ce);
+
+    std::int64_t now_ms = 0;
+    mq::ScriptEnv se;
+    se.hooks = &hooks;
+    se.policy = &policy;
+    se.registry = &reg;
+    se.context = ce.context;
+    se.print = ce.echo;
+    se.run = ce.run;
+    se.dirs = {lua_dir};
+    se.config_dir = cfg_dir;
+    se.now_ms = [&] { return now_ms; };
+#if !defined(_WIN32)
+    se.ipc_bus = &client_self;
+#endif
+
+    mq::ScriptHost host(se);
+
+    // TLO assertions prior to script run
+    CHECK(mq::parse_macro_data(ctx, "${Me.AAPoints}") == "7");
+    CHECK(mq::parse_macro_data(ctx, "${Me.AmIGroupLeader}") == "FALSE");
+    CHECK(mq::parse_macro_data(ctx, "${Group.Leader}") == "Groupie");
+    CHECK(mq::parse_macro_data(ctx, "${EverQuest.Foreground}") == "TRUE");
+    CHECK(mq::parse_macro_data(ctx, "${Zone.ShortName}") == "qeynos2");
+
+    std::string why;
+    REQUIRE(host.run("rgmercs_validation", {}, &why));
+    for (int i = 0; i < 60; ++i) {
+        now_ms += 10;
+#if !defined(_WIN32)
+        bus_server.poll_once(2);
+        client_self.poll();
+        client_peer.poll();
+#endif
+        host.pulse();
+        if (!host.running("rgmercs_validation")) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+
+    const auto list = host.list();
+    REQUIRE_FALSE(list.empty());
+    CHECK(list[0].status == "EXITED");
+    CHECK(list[0].error.empty());
+
+    bool saw_pass = false;
+    for (const auto& line : printed) {
+        if (line.find("RGMERCS_SMOKE_PASS") != std::string::npos) saw_pass = true;
+    }
+    CHECK(saw_pass);
+
+#if !defined(_WIN32)
+    // Verify /bca and /rc IPC dispatch through Commands.
+    std::string bca_cmd = "/bca //sit";
+    hooks.command(bca_cmd);
+    std::string rc_cmd = "/rc Groupie /attack on";
+    hooks.command(rc_cmd);
+    for (int i = 0; i < 15; ++i) {
+        bus_server.poll_once(2);
+        client_self.poll();
+        client_peer.poll();
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    REQUIRE(dispatched_peer_cmds.size() == 2);
+    CHECK(dispatched_peer_cmds[0] == "/sit");
+    CHECK(dispatched_peer_cmds[1] == "/attack on");
+
+    CHECK(mq::parse_macro_data(ctx, "${DanNet.Peers}") != "");
+    client_self.disconnect();
+    client_peer.disconnect();
+    bus_server.stop();
+#endif
+}
diff --git a/tests/hailstone24/rgmercs_trusted_loader_test.cpp b/tests/hailstone24/rgmercs_trusted_loader_test.cpp
new file mode 100644
index 0000000..b4e2111
--- /dev/null
+++ b/tests/hailstone24/rgmercs_trusted_loader_test.cpp
@@ -0,0 +1,345 @@
+// Trusted script-root loader vs restricted data-only config loader tests for RG Mercs:
+// 1. RG Mercs class configuration initialization for Stabbinyah (ROG on EZ Server) via trusted loadfile/dofile
+//    and MacroQuest-compatible require/package with mq, ImGui, lfs, lsqlite3, actors, bit32, and hailstone.rgmercs.
+// 2. Preserves restricted data-only loader for mq.configDir / mq.pickle, blocks config/ paths inside script roots,
+//    enforces server policy/capability ceilings, and rejects binary chunks & directory traversal.
+
+#include <doctest/doctest.h>
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "core/sha256.h"
+#include "mq/commands.h"
+#include "mq/lua_mq.h"
+#include "mq/rgmercs_bridge.h"
+#include "mq/tlo.h"
+#include "mq_test_world.h"
+#include "plugin/hooks.h"
+#include "plugin/policy.h"
+
+namespace fs = std::filesystem;
+using namespace hailstone;
+
+namespace {
+
+void write_file(const fs::path& p, const std::string& content) {
+    fs::create_directories(p.parent_path());
+    std::ofstream out(p, std::ios::binary | std::ios::trunc);
+    REQUIRE(out.good());
+    out << content;
+}
+
+struct LoaderHarness {
+    mq_test::World world{"hailstone_trusted_loader"};
+    fs::path lua_dir = world.dir / "scripts";
+    fs::path cfg_dir = lua_dir / "config";
+    fs::path char_dir = world.dir / "characters" / "ez_server_stabbinyah";
+    plugin::Hooks hooks;
+    plugin::Policy policy;
+    mq::Registry reg;
+    mq::Context ctx;
+    mq::RGMercsBridge bridge;
+    std::vector<std::string> printed;
+    std::int64_t now_ms = 0;
+    std::unique_ptr<mq::Commands> commands;
+    std::unique_ptr<mq::ScriptHost> host;
+
+    explicit LoaderHarness(bool allow_player_scripts = true) {
+        fs::create_directories(lua_dir);
+        fs::create_directories(cfg_dir);
+        fs::create_directories(char_dir);
+
+        using A = net::GameConnectionTestAccess;
+        A::character(*world.conn) = "Stabbinyah";
+        A::profile(*world.conn).class_ = 9; // Rogue (ROG)
+        auto& w = A::world(*world.conn);
+        w.spawns[1].name = "Stabbinyah";
+        w.spawns[1].class_id = 9;
+        w.zone_short_name = "surefall";
+        w.zone_long_name = "The Surefall Glade";
+
+        if (allow_player_scripts) {
+            plugin::Rules rules;
+            rules.configured = true;
+            rules.player_script_caps = plugin::kCapAll;
+            rules.social_mode = plugin::ButtonMode::Off;
+            policy.set(rules);
+        }
+
+        mq::register_game_tlos(reg);
+        ctx.registry = &reg;
+        ctx.conn = world.conn.get();
+        ctx.server_name = "EZ Server";
+        ctx.lua_dir = lua_dir.string();
+        ctx.foreground = true;
+
+        bridge.attach_character(world.dir, char_dir, "Stabbinyah", "EZ Server", "ROG");
+
+        mq::CommandEnv ce;
+        ce.hooks = &hooks;
+        ce.registry = &reg;
+        ce.context = [this]() -> const mq::Context& { return ctx; };
+        ce.echo = [this](const std::string& line) { printed.push_back(line); };
+        ce.run = [this](const std::string& line) {
+            std::string cmd = line;
+            (void)hooks.command(cmd);
+        };
+        commands = std::make_unique<mq::Commands>(ce);
+
+        mq::ScriptEnv se;
+        se.hooks = &hooks;
+        se.policy = &policy;
+        se.registry = &reg;
+        se.context = ce.context;
+        se.print = ce.echo;
+        se.run = ce.run;
+        se.dirs = {lua_dir};
+        se.config_dir = cfg_dir;
+        se.now_ms = [this] { return now_ms; };
+        se.rgmercs = &bridge;
+        host = std::make_unique<mq::ScriptHost>(se);
+    }
+
+    ~LoaderHarness() {
+        host.reset();
+        commands.reset();
+    }
+
+    bool has_line(std::string_view needle) const {
+        return std::any_of(printed.begin(), printed.end(),
+                           [&](const std::string& line) { return line.find(needle) != std::string::npos; });
+    }
+};
+
+} // namespace
+
+TEST_CASE("TrustedScriptLoader: RG Mercs loads Stabbinyah ROG class configs with active environment and compat modules") {
+    LoaderHarness h;
+
+    // Shared helper required FROM inside dynamically loaded class config chunks.
+    write_file(h.lua_dir / "rgmercs" / "utils" / "rotation_helper.lua", R"lua(
+local mq = require('mq')
+local M = {}
+function M.describe()
+    return string.format("%s/%s/%s", mq.TLO.Me.Name(), mq.TLO.Me.Class.ShortName(), mq.TLO.MacroQuest.Server())
+end
+return M
+)lua");
+
+    // RG Mercs class config in Live/rog_class_config.lua loaded via absolute loadfile(mq.luaDir .. '/...')
+    write_file(h.lua_dir / "rgmercs" / "class_configs" / "Live" / "rog_class_config.lua", R"lua(
+local mq = require('mq')
+local ImGui = require('ImGui')
+local Icons = require('mq.Icons')
+local lsqlite3 = require('lsqlite3')
+local lfs = require('lfs')
+local actors = require('actors')
+local helper = require('utils.rotation_helper')
+local hailstone = require('hailstone')
+
+assert(mq and mq.TLO and ImGui and Icons and lsqlite3 and lfs and actors and bit32)
+assert(type(IM_COL32(255, 128, 0, 255)) == 'number')
+assert(type(ImHashStr('rog')) == 'number')
+
+local dt = mq.DataType.new('RogTestType', {
+    Members = {
+        Summary = function(_, obj) return 'string', obj.summary end,
+    },
+})
+mq.AddTopLevelObject('RogInitCheck', function()
+    return dt, { summary = helper.describe() }
+end)
+
+return {
+    _version = 'Live-ROG',
+    DefaultConfig = { DoBackstab = true, HidePct = 95 },
+    RunRotation = function(self)
+        local msg = mq.TLO.RogInitCheck.Summary()
+        hailstone.rgmercs.set_setting('Class', 'DoBackstab', self.DefaultConfig.DoBackstab)
+        hailstone.rgmercs.set_module('Class', true, 'Running', 'ROG class loaded')
+        hailstone.rgmercs.set_status('Class initialized: ' .. tostring(msg))
+        return msg
+    end,
+}
+)lua");
+
+    // Class config under folder with space loaded via relative dofile(...)
+    write_file(h.lua_dir / "rgmercs" / "class_configs" / "EQ Might" / "rog_class_config.lua", R"lua(
+local mq = require('mq')
+return {
+    _version = 'EQMight-' .. mq.TLO.Me.Class.ShortName(),
+    Init = function() return 'eqmight-ok' end,
+}
+)lua");
+
+    // Classloader module mimicking RG Mercs' utils/classloader.lua using lfs + loadfile/dofile + package.searchpath
+    write_file(h.lua_dir / "rgmercs" / "utils" / "classloader.lua", R"lua(
+local mq = require('mq')
+local lfs = require('lfs')
+local classloader = {}
+
+function classloader.discover()
+    local found = {}
+    local base = mq.luaDir .. '/rgmercs/class_configs'
+    assert(lfs.attributes(base, 'mode') == 'directory')
+    for entry in lfs.dir(base) do
+        if entry ~= '.' and entry ~= '..' then
+            found[entry] = true
+        end
+    end
+    return found
+end
+
+function classloader.load(class_short)
+    local path = mq.luaDir .. '/rgmercs/class_configs/Live/' .. class_short:lower() .. '_class_config.lua'
+    local fn, err = loadfile(path)
+    assert(fn, 'trusted loadfile failed: ' .. tostring(err))
+    local cfg = fn()
+    assert(type(cfg) == 'table' and type(cfg.RunRotation) == 'function')
+
+    local eqm = dofile('class_configs/EQ Might/' .. class_short:lower() .. '_class_config.lua')
+    assert(type(eqm) == 'table' and eqm.Init() == 'eqmight-ok')
+
+    local slash_req = require('class_configs/Live/rog_class_config.lua')
+    assert(slash_req._version == 'Live-ROG')
+    return cfg
+end
+
+return classloader
+)lua");
+
+    write_file(h.lua_dir / "rgmercs" / "init.lua", R"lua(
+local mq = require('mq')
+local loader = require('utils.classloader')
+local dirs = loader.discover()
+assert(dirs['Live'] and dirs['EQ Might'])
+
+-- Verify package.searchpath & package.preload compatibility.
+local sp, sp_err = package.searchpath('utils.rotation_helper', package.path)
+assert(sp ~= nil, tostring(sp_err))
+package.preload['rog.preloaded_mod'] = function() return { ready = true } end
+assert(require('rog.preloaded_mod').ready == true)
+
+-- Explicit custom env override stays supported on loadfile(path, 't', custom_env).
+local isolated_env = { TAG = 'custom_env_ok' }
+local env_fn, env_err = loadfile('utils/rotation_helper.lua', 't', isolated_env)
+-- Helper calls require(), which is intentionally absent in isolated_env -> proves custom env was applied.
+assert(type(env_fn) == 'function', tostring(env_err))
+local ok_iso = pcall(env_fn)
+assert(not ok_iso)
+
+local cfg = loader.load(mq.TLO.Me.Class.ShortName())
+local res = cfg:RunRotation()
+print('CLASS_INIT_OK:' .. tostring(res))
+)lua");
+
+    std::string why;
+    REQUIRE(h.host->run("rgmercs", {}, &why));
+    for (int i = 0; i < 32 && h.host->running("rgmercs"); ++i) {
+        h.now_ms += 10;
+        h.host->pulse();
+    }
+
+    const auto list = h.host->list();
+    REQUIRE_FALSE(list.empty());
+    CHECK(list[0].status == "EXITED");
+    CHECK(list[0].error.empty());
+    CHECK(h.has_line("CLASS_INIT_OK:Stabbinyah/ROG/EZ Server"));
+
+    const auto snap = h.bridge.snapshot();
+    CHECK(snap.last_error.empty());
+    CHECK(snap.runtime_state == "Class initialized: Stabbinyah/ROG/EZ Server");
+}
+
+TEST_CASE("TrustedScriptLoader: preserves data-only mq.configDir loader and enforces policy & sandbox rules") {
+    LoaderHarness h;
+
+    // Put a closure-bearing Lua file inside mq.configDir -> MUST remain restricted data-only!
+    write_file(h.cfg_dir / "user_data.lua", "return { val = 42 }\n");
+    write_file(h.cfg_dir / "user_code.lua", "return { fn = function() return 99 end }\n");
+
+    // Put Lua files inside script's own config/ subdir -> MUST never be executable via loadfile or require!
+    write_file(h.lua_dir / "rgmercs" / "config" / "sneaky.lua", "return { fn = function() return 1 end }\n");
+    write_file(h.lua_dir / "rgmercs" / "class_configs" / "ok.lua", "return { tag = 'ok' }\n");
+
+    write_file(h.lua_dir / "rgmercs" / "init.lua", R"lua(
+local mq = require('mq')
+
+-- mq.pickle roundtrip and existing data-only config dir read
+mq.pickle('prefs.lua', { melee = true })
+assert(dofile('prefs.lua').melee == true)
+assert(dofile('user_data.lua').val == 42)
+
+-- Code in mq.configDir must STILL fail as non-data!
+local f_cfg, err_cfg = loadfile('user_code.lua')
+assert(f_cfg == nil and tostring(err_cfg):find('not data', 1, true) ~= nil, tostring(err_cfg))
+
+local f_abs_cfg, err_abs_cfg = loadfile(mq.configDir .. '/user_code.lua')
+assert(f_abs_cfg == nil and tostring(err_abs_cfg):find('not data', 1, true) ~= nil, tostring(err_abs_cfg))
+
+-- Files under <script>/config/ are never executable via loadfile, dofile, or require
+local f_subcfg = loadfile('config/sneaky.lua')
+assert(f_subcfg == nil)
+local ok_req_subcfg = pcall(require, 'config.sneaky')
+assert(not ok_req_subcfg)
+
+-- Binary mode and traversal outside script root must fail cleanly
+local f_bin, err_bin = loadfile('class_configs/ok.lua', 'b')
+assert(f_bin == nil and tostring(err_bin):find('binary', 1, true) ~= nil)
+local f_trav = loadfile('../../outside.lua')
+assert(f_trav == nil)
+local f_abs = loadfile('/etc/passwd')
+assert(f_abs == nil)
+
+print('SANDBOX_PRESERVED_OK')
+)lua");
+
+    std::string why;
+    REQUIRE(h.host->run("rgmercs", {}, &why));
+    for (int i = 0; i < 32 && h.host->running("rgmercs"); ++i) {
+        h.now_ms += 10;
+        h.host->pulse();
+    }
+
+    const auto list = h.host->list();
+    REQUIRE_FALSE(list.empty());
+    CHECK(list[0].status == "EXITED");
+    CHECK(list[0].error.empty());
+    CHECK(h.has_line("SANDBOX_PRESERVED_OK"));
+
+    // Policy & capability ceiling enforcement when player scripts are disallowed / server add-ons enforced.
+    LoaderHarness strict(false);
+    const std::string init_src = R"lua(
+local f_unapproved, err1 = loadfile('class_configs/unapproved.lua')
+local f_lowcap, err2 = loadfile('class_configs/lowcap.lua')
+print('UNAPPROVED', f_unapproved == nil, tostring(err1):find('may not run', 1, true) ~= nil)
+print('LOWCAP', f_lowcap == nil, tostring(err2):find('may do only', 1, true) ~= nil)
+)lua";
+    const std::string lowcap_src = "return { low = true }\n";
+    const std::string unapproved_src = "return { nope = true }\n";
+
+    write_file(strict.lua_dir / "rgmercs" / "init.lua", init_src);
+    write_file(strict.lua_dir / "rgmercs" / "class_configs" / "lowcap.lua", lowcap_src);
+    write_file(strict.lua_dir / "rgmercs" / "class_configs" / "unapproved.lua", unapproved_src);
+
+    strict.policy.set_ceilings({
+        {plugin::FileKind::Script, sha256(init_src), plugin::kCapRead | plugin::kCapCommands, "rgmercs", "srv/rg"},
+        {plugin::FileKind::Script, sha256(lowcap_src), plugin::kCapRead, "lowcap", "srv/low"},
+    });
+    strict.policy.set(plugin::parse_server_cfg(
+        "[scripts]\nplayer = off\n[addons]\nenforce = on\ndefault = deny\nrequired = srv/rg, srv/low\n"));
+
+    std::string strict_why;
+    REQUIRE(strict.host->run("rgmercs", {}, &strict_why));
+    for (int i = 0; i < 16 && strict.host->running("rgmercs"); ++i) {
+        strict.now_ms += 10;
+        strict.host->pulse();
+    }
+
+    CHECK(strict.has_line("UNAPPROVED true true"));
+    CHECK(strict.has_line("LOWCAP true true"));
+}
diff --git a/tests/hailstone24/rgmercs_validation.lua b/tests/hailstone24/rgmercs_validation.lua
new file mode 100644
index 0000000..c125121
--- /dev/null
+++ b/tests/hailstone24/rgmercs_validation.lua
@@ -0,0 +1,154 @@
+-- Smoke test exercising the core APIs required by DerpleDude/rgmercs in Hailstone 24.
+local mq = require('mq')
+local PackageMan = require('mq.PackageMan')
+local lsqlite3 = PackageMan.Require('lsqlite3')
+local lfs = PackageMan.Require('luafilesystem', 'lfs')
+local actors = require('actors')
+local icons = require('mq.ICONS')
+local Set = require('mq.set')
+local bit32 = require('bit32')
+
+assert(lsqlite3 ~= nil, 'lsqlite3 missing')
+assert(lfs ~= nil, 'lfs missing')
+assert(actors ~= nil, 'actors missing')
+assert(icons.FA_PLAY ~= nil, 'mq.ICONS missing FA_PLAY')
+assert(bit32.bor(1, 4) == 5, 'bit32.bor failed')
+
+local s = Set.new({ 'WAR', 'CLR' })
+assert(s:contains('WAR') and not s:contains('BRD'), 'mq.Set failed')
+
+-- Test lsqlite3 + 5-arg update_hook as used by rgmercs utils/config_db.lua.
+local hook_called = false
+local db = lsqlite3.open_memory()
+assert(db ~= nil, 'open_memory failed')
+db:update_hook(function(ud, op, dbName, tableName, rowId)
+    if ud == 'rg_ud' and tableName == 'settings' and rowId >= 1 then
+        hook_called = true
+    end
+end, 'rg_ud')
+assert(db:exec('CREATE TABLE settings (k TEXT PRIMARY KEY, v TEXT);') == lsqlite3.OK)
+assert(db:exec("INSERT INTO settings VALUES('PullMode', 'Chain');") == lsqlite3.OK)
+assert(hook_called, 'lsqlite3 update_hook did not fire with 5 args')
+
+local read_val = nil
+for row in db:nrows("SELECT v FROM settings WHERE k='PullMode'") do
+    read_val = row.v
+end
+assert(read_val == 'Chain', 'lsqlite3 nrows failed')
+db:close()
+
+-- Test lfs under mq.configDir and verify sandbox escape rejection.
+local cfg_dir = mq.configDir .. '/rg_smoke'
+lfs.mkdir(cfg_dir)
+local attrs = lfs.attributes(cfg_dir)
+assert(attrs and attrs.mode == 'directory', 'lfs.attributes directory check failed')
+assert(lfs.currentdir() ~= '', 'lfs.currentdir empty')
+assert(lfs.attributes('/etc/passwd') == nil, 'lfs escape should be blocked')
+assert(lfs.mkdir('/tmp/hailstone_escape_dir') == nil, 'lfs.mkdir escape should be blocked')
+assert(lsqlite3.open('/tmp/hailstone_escape_test.db') == nil, 'lsqlite3.open escape should be blocked')
+
+-- Test package & safe debug subsets.
+assert(type(package) == 'table' and type(package.config) == 'string' and #package.config >= 5, 'package.config missing')
+assert(package.loadlib == nil, 'package.loadlib must remain nil')
+assert(type(debug) == 'table' and type(debug.getinfo) == 'function' and type(debug.traceback) == 'function', 'debug.getinfo/traceback missing')
+assert(debug.getinfo(1, 'S') ~= nil, 'debug.getinfo call failed')
+assert(type(debug.traceback('ok', 1)) == 'string', 'debug.traceback call failed')
+assert(debug.sethook == nil and debug.getregistry == nil and debug.setmetatable == nil, 'unsafe debug functions must be nil')
+
+-- Test ImVec4:ToImU32() and ImGui.ConsoleWidget.
+local col = ImVec4(1, 0, 0, 1)
+assert(col:ToImU32() == 0xFF0000FF, 'ImVec4:ToImU32 mismatch')
+assert(ImGui ~= nil and ImGui.ConsoleWidget ~= nil, 'ImGui.ConsoleWidget missing')
+local con = ImGui.ConsoleWidget.new('rg_test')
+con:AppendText('line %d', 1)
+con:AppendTextUnformatted('line 2')
+assert(#con._lines == 2, 'ConsoleWidget AppendText failed')
+con:Clear()
+assert(#con._lines == 0, 'ConsoleWidget Clear failed')
+
+-- Test sandboxed io inside mq.configDir, read-only mq.luaDir, and escape rejection.
+assert(io ~= nil and type(io.open) == 'function' and type(io.close) == 'function', 'sandboxed io missing')
+assert(io.popen == nil and io.tmpfile == nil, 'unsafe io.popen/tmpfile must be nil')
+local test_file = cfg_dir .. '/io_test.txt'
+local wf, werr = io.open(test_file, 'w')
+assert(wf ~= nil, 'sandboxed io.open write failed: ' .. tostring(werr))
+assert(wf:write('alpha=1\nbeta=2\n') == wf, 'file:write return mismatch')
+assert(io.type(wf) == 'file', 'io.type open mismatch')
+assert(io.close(wf) == true, 'io.close failed')
+assert(io.type(wf) == 'closed file', 'io.type closed mismatch')
+
+local rf, rerr = io.open(test_file, 'r')
+assert(rf ~= nil, 'sandboxed io.open read failed: ' .. tostring(rerr))
+assert(rf:read('*a') == 'alpha=1\nbeta=2\n', 'file:read(*a) mismatch')
+rf:close()
+
+local seen_lines = {}
+for line in io.lines(test_file) do
+    seen_lines[#seen_lines + 1] = line
+end
+assert(#seen_lines == 2 and seen_lines[1] == 'alpha=1' and seen_lines[2] == 'beta=2', 'io.lines mismatch')
+
+local ro_script, ro_err = io.open(mq.luaDir .. '/rgmercs_validation.lua', 'r')
+assert(ro_script ~= nil, 'read-only luaDir io.open failed: ' .. tostring(ro_err))
+ro_script:close()
+assert(io.open(mq.luaDir .. '/rgmercs_validation.lua', 'w') == nil, 'write into luaDir should be blocked')
+assert(io.open('/etc/passwd', 'r') == nil, 'io.open absolute read escape should be blocked')
+assert(io.open(mq.configDir .. '/../../outside.txt', 'w') == nil, 'io.open traversal write escape should be blocked')
+
+-- Test Codex RG Mercs compat additions (mkdir no-op, load text-only, randomseed, hashes, ImGui/ImAnim/Zep).
+assert(lfs.mkdir(mq.configDir) == true, 'lfs.mkdir on existing mq.configDir should succeed')
+assert(lfs.mkdir(cfg_dir) == true, 'lfs.mkdir on existing subdir should succeed')
+math.randomseed(123.456)
+local loader_fn = assert(load('return { x = 42 }', 'cfg', 't', {}))
+assert(loader_fn().x == 42, 'text load() failed')
+assert(load('\27LuaR', 'bin', 'b') == nil, 'binary bytecode load() must be rejected')
+assert(type(ImHashStr('rgmercs')) == 'number' and ImHashStr('rgmercs') == ImHashStr('rgmercs'), 'ImHashStr mismatch')
+assert(IM_COL32(255, 0, 0, 255) == 0xFF0000FF, 'IM_COL32 mismatch')
+assert(IamWaveType ~= nil and IamWaveType.Sine == 0, 'IamWaveType missing')
+assert(require('ImAnim').Oscillate(0, 0, 10) == 5, 'ImAnim.Oscillate mismatch')
+assert(type(ImGui.GetStyleColorName(ImGuiCol.Text)) == 'string', 'GetStyleColorName missing')
+assert(ImGui.GetFont() == 3, 'GetFont mismatch')
+assert(ImGui.GetForegroundDrawList().AddImage ~= nil, 'GetForegroundDrawList missing')
+assert(getmetatable(ImGuiCol).__index.Text == ImGuiCol.Text, 'ImGuiCol __index missing')
+assert(require('Zep').Console.new():CreateBuffer() ~= nil, 'Zep CreateBuffer missing')
+
+-- Test mq.DataType.new + mq.AddTopLevelObject (RG Mercs RGMercs TLO).
+local rgType = mq.DataType.new('RGMercsType', {
+    Members = {
+        Status = function(_, _)
+            return 'string', 'Running'
+        end,
+    },
+    ToString = function(_)
+        return 'RGMercs'
+    end,
+})
+assert(rgType ~= nil, 'mq.DataType.new failed')
+mq.AddTopLevelObject('RGMercs', function()
+    return rgType, true
+end)
+assert(mq.TLO.RGMercs.Status() == 'Running', 'mq.AddTopLevelObject failed')
+
+-- Test actors dropbox register + local roundtrip over SessionBusClient.
+local received_msg = nil
+local dropbox = actors.register('rg_smoke_box', function(msg)
+    received_msg = msg.content
+end)
+assert(dropbox ~= nil, 'actors.register failed')
+dropbox:send({ character = 'Tester' }, { action = 'heal', pct = 45 })
+
+for _ = 1, 20 do
+    mq.delay(10)
+    if received_msg ~= nil then break end
+end
+assert(received_msg ~= nil and received_msg.action == 'heal' and received_msg.pct == 45, 'actors loopback failed')
+
+-- Verify essential TLOs used across RG Mercs.
+assert(mq.TLO.Me.AAPoints() == 7, 'Me.AAPoints mismatch')
+assert(mq.TLO.Me.AmIGroupLeader() == false, 'Me.AmIGroupLeader mismatch')
+assert(mq.TLO.Group.Leader() == 'Groupie', 'Group.Leader mismatch')
+assert(mq.TLO.MacroQuest.Path('lua')() ~= '', 'MacroQuest.Path(lua) empty')
+assert(mq.TLO.Lua.Script('rgmercs_validation').Status() == 'RUNNING', 'Lua.Script status mismatch')
+
+_G.RGMERCS_VALIDATION_OK = 'PASS'
+print('RGMERCS_SMOKE_PASS')
diff --git a/tests/hailstone24/session_bus_test.cpp b/tests/hailstone24/session_bus_test.cpp
new file mode 100644
index 0000000..92c9558
--- /dev/null
+++ b/tests/hailstone24/session_bus_test.cpp
@@ -0,0 +1,130 @@
+#include <doctest/doctest.h>
+
+#if !defined(_WIN32)
+#include <chrono>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "ipc/session_bus.h"
+#include "scratch_dir.h"
+
+using namespace hailstone;
+using namespace hailstone::ipc;
+
+namespace {
+
+void pump_all(SessionBusServer& srv, SessionBusClient& a, SessionBusClient& b, SessionBusClient& mgr, int rounds = 12) {
+    for (int i = 0; i < rounds; ++i) {
+        srv.poll_once(2);
+        a.poll();
+        b.poll();
+        mgr.poll();
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+}
+
+} // namespace
+
+TEST_CASE("SessionBus IPC: roster, /bca command dispatch, actors mailbox, and foreground switch") {
+    test::ScratchDir dir("hs24_bus_test");
+    const std::string sock = (dir.path() / "bus.sock").string();
+
+    SessionBusServer srv;
+    REQUIRE(srv.start(sock));
+
+    SessionBusClient c1, c2, mgr;
+    REQUIRE(c1.connect(sock, "slot01"));
+    REQUIRE(c2.connect(sock, "slot02"));
+    REQUIRE(mgr.connect(sock, "__manager__"));
+
+    std::vector<std::string> c1_cmds, c2_cmds, mgr_cmds;
+    std::vector<ActorPacket> c2_actors;
+    app::ExecutionState c1_state = app::ExecutionState::ForegroundFull;
+    app::ExecutionState c2_state = app::ExecutionState::BackgroundHeadless;
+
+    c1.set_on_command([&](const CommandPacket& cmd) {
+        c1_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "slot01", true, "ok"};
+    });
+    c2.set_on_command([&](const CommandPacket& cmd) {
+        c2_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "slot02", true, "ok"};
+    });
+    mgr.set_on_command([&](const CommandPacket& cmd) {
+        mgr_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "__manager__", true, "ok"};
+    });
+    c2.set_on_actor([&](const ActorPacket& pkt) { c2_actors.push_back(pkt); });
+    c1.set_on_state_control([&](const StateControlPacket& s) { c1_state = s.desired_state; });
+    c2.set_on_state_control([&](const StateControlPacket& s) { c2_state = s.desired_state; });
+
+    SessionSnapshot s1;
+    s1.session_id = "slot01";
+    s1.character_name = "TankOne";
+    s1.server_name = "EZ";
+    s1.class_short = "WAR";
+    s1.level = 75;
+    s1.zone_short = "potimeb";
+    s1.hp_pct = 98;
+    s1.exec_state = app::ExecutionState::ForegroundFull;
+
+    SessionSnapshot s2;
+    s2.session_id = "slot02";
+    s2.character_name = "ClericTwo";
+    s2.server_name = "EZ";
+    s2.class_short = "CLR";
+    s2.level = 75;
+    s2.zone_short = "potimeb";
+    s2.hp_pct = 100;
+    s2.mana_pct = 85;
+    s2.exec_state = app::ExecutionState::BackgroundHeadless;
+
+    CHECK(c1.publish_telemetry(s1));
+    CHECK(c2.publish_telemetry(s2));
+    pump_all(srv, c1, c2, mgr);
+
+    // Controller (__manager__) must not appear as a game slot in roster().
+    const auto roster = srv.roster();
+    REQUIRE(roster.size() == 2);
+    CHECK(mgr.cached_roster().size() == 2);
+
+    // /bca from c1 -> delivers only to c2, never c1 or __manager__.
+    CommandPacket bca;
+    bca.scope = CommandScope::AllExceptSelf;
+    bca.sender_char = "TankOne";
+    bca.sender_zone = "potimeb";
+    bca.command = "/sit";
+    CHECK(c1.send_command(bca) > 0);
+    pump_all(srv, c1, c2, mgr);
+    CHECK(c1_cmds.empty());
+    REQUIRE(c2_cmds.size() == 1);
+    CHECK(c2_cmds[0] == "/sit");
+    CHECK(mgr_cmds.empty());
+    CHECK_FALSE(srv.take_acks().empty());
+
+    // Actor mailbox routing from c1 -> ClericTwo.
+    ActorPacket ap;
+    ap.sender_session = "slot01";
+    ap.sender_char = "TankOne";
+    ap.mailbox = "rgmercs_pull";
+    ap.target_char = "ClericTwo";
+    ap.payload_json = R"({"heal":true,"hp":42})";
+    CHECK(c1.send_actor(ap));
+    pump_all(srv, c1, c2, mgr);
+    REQUIRE(c2_actors.size() == 1);
+    CHECK(c2_actors[0].mailbox == "rgmercs_pull");
+    CHECK(c2_actors[0].payload_json == ap.payload_json);
+
+    // Exclusive foreground switch via manager client -> ClericTwo becomes FG, TankOne becomes BG_HEADLESS.
+    CHECK(mgr.request_switch_foreground("ClericTwo"));
+    pump_all(srv, c1, c2, mgr);
+    CHECK(c1_state == app::ExecutionState::BackgroundHeadless);
+    CHECK(c2_state == app::ExecutionState::ForegroundFull);
+
+    c1.disconnect();
+    c2.disconnect();
+    mgr.disconnect();
+    srv.stop();
+}
+#endif
diff --git a/tools/hailstone24_manager/broker_main.cpp b/tools/hailstone24_manager/broker_main.cpp
new file mode 100644
index 0000000..6266099
--- /dev/null
+++ b/tools/hailstone24_manager/broker_main.cpp
@@ -0,0 +1,454 @@
+// Hailstone 24 Session Broker & Child Process Supervisor.
+// Runs the local AF_UNIX IPC hub (hailstone::ipc::SessionBusServer), optionally imports MacroQuest
+// AutoLogin credentials into Hailstone's isolated data directory/keyring, and supervises up to 24
+// independent Hailstone client processes (1 foreground, 23 headless background).
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <format>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+#if !defined(_WIN32)
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+
+#include "app/execution_state.h"
+#include "core/ini_file.h"
+#include "core/mq_login_import.h"
+#include "core/wipe.h"
+#include "ipc/session_bus.h"
+#include "platform/paths.h"
+
+namespace fs = std::filesystem;
+using namespace hailstone;
+
+namespace {
+
+std::atomic<bool> g_stop_requested{false};
+
+void handle_signal(int) {
+    g_stop_requested.store(true, std::memory_order_relaxed);
+}
+
+struct RosterSlot {
+    std::string section;
+    bool enabled = true;
+    std::string session_id;
+    std::string server_id;
+    std::string world;
+    std::string account;
+    std::string character;
+    std::string group_leader;
+    bool headless = true;
+    bool auto_kick = true;
+    int bg_tick_hz = 0;
+    std::string gpu_mode;
+};
+
+struct SupervisedChild {
+#if !defined(_WIN32)
+    pid_t pid = -1;
+#endif
+    std::string session_id;
+    std::string character;
+    bool running = false;
+};
+
+struct BrokerOptions {
+    std::string socket_path;
+    fs::path data_dir;
+    fs::path game_dir;
+    fs::path roster_path;
+    fs::path hailstone_bin;
+    fs::path gpu_broker_bin;
+    fs::path import_mq_path;
+    std::string mq_master_pass;
+    std::string server_override;
+    std::string world_override;
+    std::string gpu_mode = "cached";
+    int bg_tick_hz = 25;
+    int stagger_ms = 350;
+    int status_interval_s = 15;
+    bool launch_all = false;
+    bool shared_gpu = false;
+    bool exit_when_empty = false;
+};
+
+void usage() {
+    std::printf(
+        "usage: hailstone24_broker [options]\n"
+        "  --socket PATH             local AF_UNIX bus socket (default: $XDG_RUNTIME_DIR/hailstone24/bus.sock)\n"
+        "  --data-dir DIR            isolated Hailstone data directory for all 24 sessions\n"
+        "  --game-dir DIR            read-only EverQuest RoF2 game directory forwarded to clients\n"
+        "  --roster PATH             hailstone24_roster.ini file listing slot01..slot24\n"
+        "  --hailstone-bin PATH      path to hailstone client executable (default: sibling hailstone)\n"
+        "  --import-mq-logins PATH   import MQ login.db / MQ2AutoLogin.ini into isolated keyring & write roster\n"
+        "  --mq-master-pass PASS     optional MacroQuest login.db master password (also $MQ_MASTER_PASSWORD)\n"
+        "  --server ID_OR_NAME       override login server profile id/name for import and launches\n"
+        "  --world NAME_OR_KEYWORD   override world server name, id, or unique keyword filter for launches\n"
+        "  --launch-all              stagger-launch enabled slots from --roster (slot01 foreground, others headless)\n"
+        "  --bg-tick-hz N            override background simulation Hz (10..60, default 25)\n"
+        "  --gpu-mode MODE           deferred | cached | shared-broker (default: cached)\n"
+        "  --shared-gpu              set --gpu-mode shared-broker and start hailstone_gpu_cache_broker if present\n"
+        "  --stagger-ms N            delay in ms between launching child clients (default 350)\n"
+        "  --status-interval-s N     periodic telemetry summary interval in seconds (0 = quiet, default 15)\n"
+        "  --exit-when-empty         exit automatically once launched children all exit\n"
+        "  -h, --help                show this help\n");
+}
+
+BrokerOptions parse_args(int argc, char** argv) {
+    BrokerOptions o;
+    if (const char* env_data = std::getenv("HAILSTONE_DATA_DIR"); env_data && *env_data) {
+        o.data_dir = env_data;
+    }
+    if (const char* env_pw = std::getenv("MQ_MASTER_PASSWORD"); env_pw && *env_pw) {
+        o.mq_master_pass = env_pw;
+    }
+    for (int i = 1; i < argc; ++i) {
+        const std::string_view a = argv[i];
+        auto need = [&]() -> const char* {
+            if (i + 1 >= argc) {
+                std::fprintf(stderr, "Missing value for %s\n", argv[i]);
+                std::exit(2);
+            }
+            return argv[++i];
+        };
+        if (a == "--socket") o.socket_path = need();
+        else if (a == "--data-dir") o.data_dir = need();
+        else if (a == "--game-dir") o.game_dir = need();
+        else if (a == "--roster") o.roster_path = need();
+        else if (a == "--hailstone-bin") o.hailstone_bin = need();
+        else if (a == "--import-mq-logins") o.import_mq_path = need();
+        else if (a == "--mq-master-pass") o.mq_master_pass = need();
+        else if (a == "--server") o.server_override = need();
+        else if (a == "--world") o.world_override = need();
+        else if (a == "--gpu-mode") o.gpu_mode = need();
+        else if (a == "--bg-tick-hz") o.bg_tick_hz = std::clamp(std::atoi(need()), 10, 60);
+        else if (a == "--stagger-ms") o.stagger_ms = std::clamp(std::atoi(need()), 0, 10000);
+        else if (a == "--status-interval-s") o.status_interval_s = std::max(0, std::atoi(need()));
+        else if (a == "--launch-all") o.launch_all = true;
+        else if (a == "--shared-gpu") {
+            o.shared_gpu = true;
+            o.gpu_mode = "shared-broker";
+        } else if (a == "--exit-when-empty") {
+            o.exit_when_empty = true;
+        } else if (a == "--help" || a == "-h") {
+            usage();
+            std::exit(0);
+        } else {
+            std::fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            std::exit(2);
+        }
+    }
+    return o;
+}
+
+std::vector<RosterSlot> load_roster(const fs::path& path, const BrokerOptions& opts) {
+    std::vector<RosterSlot> out;
+    IniFile ini;
+    if (!ini.load(path)) return out;
+    std::string def_server = ini.get_string("global", "default_server");
+    if (def_server.empty()) def_server = ini.get_string("Cluster", "server", opts.server_override);
+    if (!opts.server_override.empty()) def_server = opts.server_override;
+    std::string def_world = ini.get_string("global", "default_world", opts.world_override);
+    if (!opts.world_override.empty()) def_world = opts.world_override;
+    const bool def_auto_kick = ini.get_int("global", "auto_kick", 1) != 0;
+    const std::string def_gpu = ini.get_string("global", "gpu_mode", opts.gpu_mode);
+    const int def_hz = std::clamp(ini.get_int("global", "bg_tick_hz", opts.bg_tick_hz), 10, 60);
+
+    for (const auto& sec : ini.sections()) {
+        if (sec.rfind("slot", 0) != 0 && sec.rfind("Slot", 0) != 0) continue;
+        RosterSlot slot;
+        slot.section = sec;
+        slot.enabled = ini.get_int(sec, "enabled", 1) != 0;
+        slot.session_id = ini.get_string(sec, "session_id", sec);
+        std::string slot_srv = ini.get_string(sec, "server_id");
+        if (slot_srv.empty()) slot_srv = ini.get_string(sec, "server", def_server);
+        slot.server_id = opts.server_override.empty() ? slot_srv : opts.server_override;
+        slot.world = opts.world_override.empty() ? ini.get_string(sec, "world", def_world) : opts.world_override;
+        slot.account = ini.get_string(sec, "account");
+        slot.character = ini.get_string(sec, "character");
+        slot.group_leader = ini.get_string(sec, "group_leader");
+        if (auto h = ini.get(sec, "headless")) {
+            slot.headless = ini.get_int(sec, "headless", out.empty() ? 0 : 1) != 0;
+        } else if (auto st = ini.get(sec, "state")) {
+            slot.headless = (*st != "foreground");
+        } else {
+            slot.headless = !out.empty();
+        }
+        slot.auto_kick = ini.get_int(sec, "auto_kick", def_auto_kick ? 1 : 0) != 0;
+        slot.bg_tick_hz = std::clamp(ini.get_int(sec, "bg_tick_hz", def_hz), 10, 60);
+        slot.gpu_mode = ini.get_string(sec, "gpu_mode", def_gpu);
+        if (slot.enabled && !slot.account.empty()) out.push_back(std::move(slot));
+        if (out.size() >= 24) break;
+    }
+    return out;
+}
+
+#if !defined(_WIN32)
+pid_t spawn_process(const std::vector<std::string>& args) {
+    if (args.empty()) return -1;
+    std::vector<char*> c_args;
+    c_args.reserve(args.size() + 1);
+    for (const auto& s : args) c_args.push_back(const_cast<char*>(s.c_str()));
+    c_args.push_back(nullptr);
+
+    const pid_t pid = ::fork();
+    if (pid < 0) return -1;
+    if (pid == 0) {
+        ::execvp(c_args[0], c_args.data());
+        std::fprintf(stderr, "execvp(%s) failed: %s\n", c_args[0], std::strerror(errno));
+        ::_exit(127);
+    }
+    return pid;
+}
+
+void terminate_children(std::vector<SupervisedChild>& children, pid_t& gpu_pid) {
+    for (const auto& c : children) {
+        if (c.running && c.pid > 0) ::kill(c.pid, SIGTERM);
+    }
+    if (gpu_pid > 0) ::kill(gpu_pid, SIGTERM);
+
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (std::chrono::steady_clock::now() < deadline) {
+        bool any_alive = false;
+        for (auto& c : children) {
+            if (!c.running || c.pid <= 0) continue;
+            int status = 0;
+            const pid_t r = ::waitpid(c.pid, &status, WNOHANG);
+            if (r == c.pid) {
+                c.running = false;
+            } else {
+                any_alive = true;
+            }
+        }
+        if (gpu_pid > 0) {
+            int status = 0;
+            if (::waitpid(gpu_pid, &status, WNOHANG) == gpu_pid) {
+                gpu_pid = -1;
+            } else {
+                any_alive = true;
+            }
+        }
+        if (!any_alive) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    }
+
+    for (auto& c : children) {
+        if (c.running && c.pid > 0) {
+            ::kill(c.pid, SIGKILL);
+            int status = 0;
+            ::waitpid(c.pid, &status, 0);
+            c.running = false;
+        }
+    }
+    if (gpu_pid > 0) {
+        ::kill(gpu_pid, SIGKILL);
+        int status = 0;
+        ::waitpid(gpu_pid, &status, 0);
+        gpu_pid = -1;
+    }
+}
+#endif
+
+} // namespace
+
+int main(int argc, char** argv) {
+    BrokerOptions opts = parse_args(argc, argv);
+
+    if (!opts.data_dir.empty()) {
+        std::error_code ec;
+        fs::create_directories(opts.data_dir, ec);
+        platform::use_data_dir(opts.data_dir, "--data-dir");
+    }
+    if (opts.socket_path.empty()) opts.socket_path = ipc::default_bus_socket_path();
+    if (opts.roster_path.empty()) opts.roster_path = platform::data_dir() / "hailstone24_roster.ini";
+
+    if (opts.hailstone_bin.empty()) {
+        fs::path self_dir = platform::install_dir();
+        fs::path candidate = self_dir / "hailstone";
+        if (fs::exists(candidate)) opts.hailstone_bin = candidate;
+        else opts.hailstone_bin = "hailstone";
+    }
+    if (opts.gpu_broker_bin.empty()) {
+        fs::path candidate = platform::install_dir() / "hailstone_gpu_cache_broker";
+        if (fs::exists(candidate)) opts.gpu_broker_bin = candidate;
+    }
+
+    if (!opts.import_mq_path.empty()) {
+        core::MqImportOptions imp;
+        imp.source_path = opts.import_mq_path;
+        imp.master_password = opts.mq_master_pass;
+        imp.target_server_id = opts.server_override;
+        imp.servers_dir = platform::servers_dir();
+        imp.roster_out = opts.roster_path;
+        const auto res = core::import_mq_logins(imp);
+        core::wipe(imp.master_password);
+        core::wipe(opts.mq_master_pass);
+        if (!res.ok) {
+            std::fprintf(stderr, "[broker] MQ login import failed (%s): %s\n",
+                         res.source_kind.c_str(), res.error.c_str());
+            return 1;
+        }
+        std::printf("[broker] Imported %zu/%zu MQ logins (%zu keyring passwords, %zu characters) -> %s\n",
+                    res.accounts_imported, res.accounts_found, res.passwords_saved, res.characters_linked,
+                    opts.roster_path.string().c_str());
+        for (const auto& w : res.warnings) std::printf("[broker] warning: %s\n", w.c_str());
+    }
+    core::wipe(opts.mq_master_pass);
+
+    std::signal(SIGINT, handle_signal);
+    std::signal(SIGTERM, handle_signal);
+#if !defined(_WIN32)
+    std::signal(SIGPIPE, SIG_IGN);
+#endif
+
+    ipc::SessionBusServer bus;
+    if (!bus.start(opts.socket_path)) {
+        std::fprintf(stderr, "[broker] Failed to bind session IPC socket: %s\n", opts.socket_path.c_str());
+        return 1;
+    }
+    std::printf("[broker] Listening on %s (data-dir=%s)\n",
+                opts.socket_path.c_str(), platform::data_dir().string().c_str());
+    std::fflush(stdout);
+
+    std::vector<SupervisedChild> children;
+#if !defined(_WIN32)
+    pid_t gpu_broker_pid = -1;
+    if (opts.shared_gpu && !opts.gpu_broker_bin.empty() && fs::exists(opts.gpu_broker_bin)) {
+        gpu_broker_pid = spawn_process({opts.gpu_broker_bin.string(), "--serve"});
+        if (gpu_broker_pid > 0) {
+            std::printf("[broker] Started hailstone_gpu_cache_broker (pid=%d)\n", static_cast<int>(gpu_broker_pid));
+        }
+    }
+
+    if (opts.launch_all) {
+        const auto slots = load_roster(opts.roster_path, opts);
+        if (slots.empty()) {
+            std::fprintf(stderr, "[broker] --launch-all set but no enabled slots in %s\n",
+                         opts.roster_path.string().c_str());
+        }
+        for (std::size_t idx = 0; idx < slots.size() && !g_stop_requested.load(std::memory_order_relaxed); ++idx) {
+            const auto& slot = slots[idx];
+            std::vector<std::string> args;
+            args.push_back(opts.hailstone_bin.string());
+            args.push_back("--data-dir");
+            args.push_back(platform::data_dir().string());
+            if (!opts.game_dir.empty()) {
+                args.push_back("--game-dir");
+                args.push_back(opts.game_dir.string());
+            }
+            if (!slot.server_id.empty()) {
+                args.push_back("--server");
+                args.push_back(slot.server_id);
+            }
+            if (!slot.world.empty()) {
+                args.push_back("--world");
+                args.push_back(slot.world);
+            }
+            args.push_back("--account");
+            args.push_back(slot.account);
+            if (!slot.character.empty()) {
+                args.push_back("--character");
+                args.push_back(slot.character);
+            }
+            if (slot.auto_kick) args.push_back("--auto-kick");
+            args.push_back("--session-id");
+            args.push_back(slot.session_id);
+            args.push_back("--ipc-socket");
+            args.push_back(opts.socket_path);
+            args.push_back("--bg-tick-hz");
+            args.push_back(std::to_string(slot.bg_tick_hz));
+            args.push_back("--gpu-mode");
+            args.push_back(slot.gpu_mode);
+            if (slot.headless) args.push_back("--headless-bg");
+
+            const pid_t cpid = spawn_process(args);
+            if (cpid > 0) {
+                children.push_back(SupervisedChild{cpid, slot.session_id, slot.character, true});
+                std::printf("[broker] Launched %s char=%s mode=%s (pid=%d)\n",
+                            slot.session_id.c_str(),
+                            slot.character.empty() ? "<select>" : slot.character.c_str(),
+                            slot.headless ? "BACKGROUND_HEADLESS" : "FOREGROUND_FULL",
+                            static_cast<int>(cpid));
+            } else {
+                std::fprintf(stderr, "[broker] Failed to spawn %s\n", slot.session_id.c_str());
+            }
+            if (idx + 1 < slots.size() && opts.stagger_ms > 0) {
+                bus.poll_once(opts.stagger_ms);
+            }
+        }
+        std::fflush(stdout);
+    }
+#endif
+
+    auto last_summary = std::chrono::steady_clock::now();
+    while (!g_stop_requested.load(std::memory_order_relaxed)) {
+        bus.poll_once(20);
+        (void)bus.take_acks();
+
+#if !defined(_WIN32)
+        int active_children = 0;
+        for (auto& c : children) {
+            if (!c.running || c.pid <= 0) continue;
+            int status = 0;
+            const pid_t r = ::waitpid(c.pid, &status, WNOHANG);
+            if (r == c.pid) {
+                c.running = false;
+                const int code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+                std::printf("[broker] Child %s (%s) exited (status=%d)\n",
+                            c.session_id.c_str(), c.character.c_str(), code);
+                std::fflush(stdout);
+            } else {
+                ++active_children;
+            }
+        }
+        if (opts.exit_when_empty && !children.empty() && active_children == 0) {
+            std::printf("[broker] All launched sessions exited; stopping.\n");
+            break;
+        }
+#endif
+
+        if (opts.status_interval_s > 0) {
+            const auto now = std::chrono::steady_clock::now();
+            if (now - last_summary >= std::chrono::seconds(opts.status_interval_s)) {
+                last_summary = now;
+                const auto roster = bus.roster();
+                std::uint64_t total_rss_mib = 0;
+                std::uint64_t total_vram_mib = 0;
+                std::string fg = "none";
+                for (const auto& s : roster) {
+                    total_rss_mib += s.rss_mib;
+                    total_vram_mib += s.vram_mib;
+                    if (s.exec_state == app::ExecutionState::ForegroundFull) {
+                        fg = s.character_name.empty() ? s.session_id : s.character_name;
+                    }
+                }
+                std::printf("[broker] Connected=%zu/24 Foreground=%s RSS=%llu MiB EstVRAM=%llu MiB\n",
+                            roster.size(), fg.c_str(),
+                            static_cast<unsigned long long>(total_rss_mib),
+                            static_cast<unsigned long long>(total_vram_mib));
+                std::fflush(stdout);
+            }
+        }
+    }
+
+#if !defined(_WIN32)
+    terminate_children(children, gpu_broker_pid);
+#endif
+    bus.stop();
+    std::printf("[broker] Shutdown complete.\n");
+    return 0;
+}
