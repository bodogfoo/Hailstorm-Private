+    if (trimmed.empty()) return true;
+    std::size_t pos = 0;
+    while (pos < trimmed.size()) {
+        while (pos < trimmed.size() && std::isspace(static_cast<unsigned char>(trimmed[pos]))) ++pos;
+        if (pos >= trimmed.size()) break;
