+local STATUS_LABEL = {
+  stopped   = "Stopped",
+  starting  = "Starting",
+  running   = "Running",
+  paused    = "Paused",
+  stopping  = "Stopping",
+  reloading = "Reloading",
+  exited    = "Stopped",
+  error     = "Error",
+}
+
+local activeSection = "Combat"
+local filterText = ""
+local cmdInput = ""
