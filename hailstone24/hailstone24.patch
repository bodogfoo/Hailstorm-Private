+int l_sqlite_stmt_nrows(lua_State* L) {
+    check_stmt(L);
+    lua_pushvalue(L, 1);
+    lua_pushcclosure(L, l_sqlite_stmt_nrows_iter, 1);
+    return 1;
+}
