new file mode 100644
index 0000000..6e3e405
--- /dev/null
+++ b/src/mq/rgmercs_bridge.h
@@ -0,0 +1,167 @@
+#pragma once
+
+// Hailstone-native bridge for RG Mercs: decouples gameplay/automation state from presentation.
+// Keeps bounded logs & error banner state, module toggles, typed RG Mercs settings persisted per character inside
+// Hailstone's data directory, read-only SQLite / Lua-table settings import, and a script-facing adapter queue.
+
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace hailstone::mq {
+
+class RGMercsBridge {
+public:
+    struct SettingEntry {
+        std::string key;
+        std::string category; // Combat, Targeting, Healing, Buffs, Debuffs, Movement, Loot, Class, General
+        std::string type;     // bool, int, float, string, choice
+        std::string value;
+        std::string default_value;
+        std::string description;
+        double min_val = 0.0;
+        double max_val = 100.0;
+        std::vector<std::string> choices;
+        bool imported = false;
+    };
+
+    struct ModuleState {
+        std::string name;
+        bool enabled = true;
+        std::string status = "Idle"; // Idle, Running, Paused, Disabled, Error
+        std::string detail;
+    };
+
+    struct LogEntry {
+        std::string timestamp;
+        std::string level; // info, warn, error
+        std::string message;
+    };
+
+    struct ImportResult {
+        bool ok = false;
+        int imported_count = 0;
+        std::string source;
+        std::string error;
+    };
+
+    struct Snapshot {
+        std::string character;
+        std::string server;
+        std::string class_name;
+        std::string settings_path;
+        std::string imported_from;
+        int imported_count = 0;
+        std::string script_status; // "", "running", "paused", "exited", "error"
+        std::string runtime_state; // adapter status override / detail
+        std::string last_error;
+        int error_count = 0;
