+// ---------------------------------------------------------------- AggroMeterWnd (CAggroMeterWnd, not decoded)
+
+// Its labels and gauge are EQTypes (app/lua_eq_values.cpp 149, 302..307); the window opens when the server first
+// sends the meter.
+class AggroMeterWindow : public StockWindow {
+public:
