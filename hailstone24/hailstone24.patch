+const RGMercsBridge::SettingEntry* RGMercsBridge::find_setting_locked(std::string_view key) const {
+    for (const auto& s : settings_) {
+        if (iequals_ascii(s.key, key)) return &s;
+    }
+    return nullptr;
+}
