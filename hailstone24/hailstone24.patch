+class MovementController {
+public:
+    void reset();
+
+    void clear_manual_override();
+
+    bool manual_override_active(std::uint64_t now_ms) const noexcept;
+    std::uint64_t manual_override_remaining_ms(std::uint64_t now_ms) const noexcept;
