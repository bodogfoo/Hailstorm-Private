+std::string RGMercsBridge::infer_type(std::string_view value) {
+    const std::string t = to_lower_ascii(trim_ascii(value));
+    if (t == "true" || t == "false") return "bool";
+    if (!t.empty()) {
+        char* end_int = nullptr;
+        (void)std::strtoll(t.c_str(), &end_int, 10);
+        if (end_int && *end_int == '\0') return "int";
+        char* end_dbl = nullptr;
+        (void)std::strtod(t.c_str(), &end_dbl);
+        if (end_dbl && *end_dbl == '\0') return "float";
+    }
+    return "string";
+}
+
+std::string RGMercsBridge::normalize_value(std::string_view type, std::string_view raw) {
+    const std::string t = trim_ascii(raw);
+    if (type == "bool") {
+        const std::string low = to_lower_ascii(t);
+        if (low == "1" || low == "true" || low == "yes" || low == "on" || low == "enabled") return "true";
+        return "false";
+    }
+    if (type == "int") {
+        char* end = nullptr;
+        const long long v = std::strtoll(t.c_str(), &end, 10);
+        if (end != t.c_str() && *end == '\0') return std::to_string(v);
+        char* end_f = nullptr;
+        const double d = std::strtod(t.c_str(), &end_f);
+        if (end_f != t.c_str()) return std::to_string(static_cast<long long>(d));
+        return "0";
+    }
+    if (type == "float") {
+        char* end = nullptr;
+        const double d = std::strtod(t.c_str(), &end);
+        if (end != t.c_str()) return std::format("{:.3g}", d);
+        return "0";
+    }
+    return t;
+}
