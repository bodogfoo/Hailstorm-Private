+#include <doctest/doctest.h>
+#include <sqlite3.h>
+
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include "core/ini_file.h"
+#include "core/mq_login_import.h"
+#include "core/server_profile.h"
+#include "platform/credentials.h"
+#include "scratch_dir.h"
+
+namespace fs = std::filesystem;
+using namespace hailstone;
+
+namespace {
+
+// Inverse/identical symmetric XOR encryption matching MacroQuest Next src/login/Login.cpp.
+std::string xor_transform(std::string_view input, std::string_view key) {
+    if (key.empty()) return std::string(input);
+    std::string out(input);
+    std::size_t idx = 0;
+    for (char& c : out) c = static_cast<char>(c ^ key[++idx % key.size()]);
+    return out;
+}
+
+void exec_sql(sqlite3* db, const char* sql) {
+    char* err = nullptr;
+    const int rc = sqlite3_exec(db, sql, nullptr, nullptr, &err);
+    if (rc != SQLITE_OK) {
+        std::string msg = err ? err : "sqlite error";
+        sqlite3_free(err);
+        FAIL(msg);
+    }
+}
+
+void build_test_login_db(const fs::path& db_path, std::string_view master_pw) {
+    sqlite3* db = nullptr;
+    REQUIRE(sqlite3_open(db_path.string().c_str(), &db) == SQLITE_OK);
+
+    exec_sql(db, R"(
+        CREATE TABLE settings (key TEXT PRIMARY KEY, value TEXT);
+        CREATE TABLE accounts (id INTEGER PRIMARY KEY AUTOINCREMENT, account TEXT NOT NULL, password TEXT, server_type TEXT);
+        CREATE TABLE characters (id INTEGER PRIMARY KEY AUTOINCREMENT, account_id INTEGER, server TEXT, character TEXT);
+        CREATE TABLE personas (character_id INTEGER, class TEXT, level INTEGER, last_seen INTEGER);
+        CREATE TABLE profile_groups (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT);
+        CREATE TABLE profiles (id INTEGER PRIMARY KEY AUTOINCREMENT, group_id INTEGER, character_id INTEGER, hotkey TEXT, sort_order INTEGER, will_load INTEGER);
+    )");
+
+    auto insert_account = [&](const char* acct, std::string_view pw, const char* srv_type) {
+        const std::string enc = master_pw.empty() ? std::string(pw) : xor_transform(pw, master_pw);
+        sqlite3_stmt* st = nullptr;
+        REQUIRE(sqlite3_prepare_v2(db, "INSERT INTO accounts(account, password, server_type) VALUES(?, ?, ?)",
+                                   -1, &st, nullptr) == SQLITE_OK);
+        sqlite3_bind_text(st, 1, acct, -1, SQLITE_TRANSIENT);
+        sqlite3_bind_blob(st, 2, enc.data(), static_cast<int>(enc.size()), SQLITE_TRANSIENT);
+        sqlite3_bind_text(st, 3, srv_type, -1, SQLITE_TRANSIENT);
+        REQUIRE(sqlite3_step(st) == SQLITE_DONE);
+        sqlite3_finalize(st);
+    };
+
+    if (!master_pw.empty()) {
+        exec_sql(db, "INSERT INTO settings(key, value) VALUES('master_pass', 'sha256_stub_hash');");
+    }
+
+    insert_account("ezbox01", "TankPass!24", "eqemu");
+    insert_account("ezbox02", "ClericPass#99", "eqemu");
+    exec_sql(db, "INSERT INTO characters(account_id, server, character) VALUES(1, 'EZ Server', 'BigTank');");
+    exec_sql(db, "INSERT INTO characters(account_id, server, character) VALUES(2, 'EZ Server', 'HealBot');");
+    exec_sql(db, "INSERT INTO personas(character_id, class, level, last_seen) VALUES(1, 'Warrior', 75, 100);");
+    exec_sql(db, "INSERT INTO personas(character_id, class, level, last_seen) VALUES(2, 'Cleric', 75, 100);");
+    exec_sql(db, "INSERT INTO profile_groups(name) VALUES('MainRaid');");
+    exec_sql(db, "INSERT INTO profiles(group_id, character_id, hotkey, sort_order, will_load) VALUES(1, 1, 'F1', 1, 1);");
+    exec_sql(db, "INSERT INTO profiles(group_id, character_id, hotkey, sort_order, will_load) VALUES(1, 2, 'F2', 2, 1);");
+
+    sqlite3_close(db);
+}
+
+} // namespace
+
+TEST_CASE("MQ AutoLogin importer: decrypts login.db XOR passwords into isolated keyring without writing plaintext passwords") {
+    test::ScratchDir dir("hs24_mq_import");
+    const fs::path db_path = dir.path() / "login.db";
+    const fs::path servers = dir.path() / "servers";
+    const fs::path roster = dir.path() / "hailstone24_roster.ini";
+
+    build_test_login_db(db_path, "MyMasterSecret");
+
+    platform::MemoryCredentials creds;
+    core::MqImportOptions opts;
+    opts.source_path = db_path;
+    opts.master_password = "MyMasterSecret";
+    opts.servers_dir = servers;
+    opts.roster_out = roster;
+
+    const auto res = core::import_mq_logins(opts, creds);
+    CHECK(res.ok);
+    CHECK(res.source_kind == "sqlite-login-db");
+    CHECK(res.master_password_required);
+    CHECK(res.accounts_imported == 2);
+    CHECK(res.passwords_saved == 2);
+    CHECK(res.characters_linked == 2);
+
+    const std::string cred_srv = platform::credential_server(res.server_host, res.server_port);
+    CHECK(creds.load(cred_srv, "ezbox01") == "TankPass!24");
+    CHECK(creds.load(cred_srv, "ezbox02") == "ClericPass#99");
+
+    const auto profile = load_profile(res.server_profile_id, servers);
+    REQUIRE(profile.has_value());
+    REQUIRE(profile->accounts.size() == 2);
+    CHECK(profile->accounts[0].username == "ezbox01");
+    CHECK(profile->accounts[0].character == "BigTank");
+    CHECK(profile->accounts[1].username == "ezbox02");
+    CHECK(profile->accounts[1].character == "HealBot");
+
+    // Ensure generated roster INI matches hailstone24_broker schema and never leaks plaintext passwords.
+    std::ifstream in(roster);
+    std::stringstream ss;
+    ss << in.rdbuf();
+    const std::string roster_text = ss.str();
+    CHECK(roster_text.find("BigTank") != std::string::npos);
+    CHECK(roster_text.find("HealBot") != std::string::npos);
+    CHECK(roster_text.find("TankPass!24") == std::string::npos);
+    CHECK(roster_text.find("ClericPass#99") == std::string::npos);
+
+    IniFile parsed_roster;
+    REQUIRE(parsed_roster.load(roster));
+    CHECK(parsed_roster.get_string("global", "default_server") == res.server_profile_id);
+    CHECK(parsed_roster.get_string("global", "default_world") == "EZ Server");
+    CHECK(parsed_roster.get_int("global", "auto_kick", 0) == 1);
+    CHECK(parsed_roster.get_int("slot01", "enabled", 0) == 1);
+    CHECK(parsed_roster.get_string("slot01", "session_id") == "slot01");
+    CHECK(parsed_roster.get_string("slot01", "server_id") == res.server_profile_id);
+    CHECK(parsed_roster.get_string("slot01", "world") == "EZ Server");
+    CHECK(parsed_roster.get_string("slot01", "account") == "ezbox01");
+    CHECK(parsed_roster.get_string("slot01", "character") == "BigTank");
+    CHECK(parsed_roster.get_int("slot01", "headless", -1) == 0);
+    CHECK(parsed_roster.get_int("slot02", "headless", -1) == 1);
+}
+
+TEST_CASE("MQ AutoLogin importer: supports MQ2AutoLogin.ini and caret-delimited lists") {
+    test::ScratchDir dir("hs24_mq_ini_import");
+    const fs::path ini_path = dir.path() / "MQ2AutoLogin.ini";
+    const fs::path txt_path = dir.path() / "logins.txt";
+    const fs::path servers = dir.path() / "servers";
+
+    {
+        std::ofstream out(ini_path);
+        out << "[Settings]\nDefaultServer=EZ Server\n";
+        out << "[Profiles]\nGroup1=bardbox\n";
+        out << "[bardbox]\nServer=EZ Server\nAccount=ezbox03\nPassword=SongPassword!\nCharacter=MelodyBot\n";
+    }
+    {
+        std::ofstream out(txt_path);
+        out << "EZ Server^ezbox04^PullMonk^KickSecret!\n";
+    }
+
+    platform::MemoryCredentials creds;
+    core::MqImportOptions o1;
+    o1.source_path = ini_path;
+    o1.servers_dir = servers;
+    const auto r1 = core::import_mq_logins(o1, creds);
+    CHECK(r1.ok);
+    CHECK(r1.source_kind == "autologin-ini");
+    CHECK(r1.accounts_imported == 1);
+    CHECK(creds.load(platform::credential_server(r1.server_host, r1.server_port), "ezbox03") == "SongPassword!");
+
+    core::MqImportOptions o2;
+    o2.source_path = txt_path;
+    o2.servers_dir = servers;
+    const auto r2 = core::import_mq_logins(o2, creds);
+    CHECK(r2.ok);
+    CHECK(r2.source_kind == "delimited-list");
+    CHECK(r2.accounts_imported == 1);
+    CHECK(creds.load(platform::credential_server(r2.server_host, r2.server_port), "ezbox04") == "KickSecret!");
+}
diff --git a/tests/hailstone24/session_bus_test.cpp b/tests/hailstone24/session_bus_test.cpp
new file mode 100644
index 0000000..57aece6
--- /dev/null
+++ b/tests/hailstone24/session_bus_test.cpp
@@ -0,0 +1,130 @@
+#include <doctest/doctest.h>
+
+#if !defined(_WIN32)
+#include <chrono>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "ipc/session_bus.h"
+#include "scratch_dir.h"
+
+using namespace hailstone;
+using namespace hailstone::ipc;
+
+namespace {
+
+void pump_all(SessionBusServer& srv, SessionBusClient& a, SessionBusClient& b, SessionBusClient& mgr, int rounds = 12) {
+    for (int i = 0; i < rounds; ++i) {
+        srv.poll_once(2);
+        a.poll();
+        b.poll();
+        mgr.poll();
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+}
+
+} // namespace
+
+TEST_CASE("SessionBus IPC: roster, /bca command dispatch, actors mailbox, and foreground switch") {
+    test::ScratchDir dir("hs24_bus_test");
+    const std::string sock = (dir.path() / "bus.sock").string();
+
+    SessionBusServer srv;
+    REQUIRE(srv.start(sock));
+
+    SessionBusClient c1, c2, mgr;
+    REQUIRE(c1.connect(sock, "slot01"));
+    REQUIRE(c2.connect(sock, "slot02"));
+    REQUIRE(mgr.connect(sock, "__manager__"));
+
+    std::vector<std::string> c1_cmds, c2_cmds, mgr_cmds;
+    std::vector<ActorPacket> c2_actors;
+    app::ExecutionState c1_state = app::ExecutionState::ForegroundFull;
+    app::ExecutionState c2_state = app::ExecutionState::BackgroundHeadless;
+
+    c1.set_on_command([&](const CommandPacket& cmd) {
+        c1_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "slot01", true, "ok"};
+    });
+    c2.set_on_command([&](const CommandPacket& cmd) {
+        c2_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "slot02", true, "ok"};
+    });
+    mgr.set_on_command([&](const CommandPacket& cmd) {
+        mgr_cmds.push_back(cmd.command);
+        return CommandAckPacket{cmd.seq, "__manager__", true, "ok"};
+    });
+    c2.set_on_actor([&](const ActorPacket& pkt) { c2_actors.push_back(pkt); });
+    c1.set_on_state_control([&](const StateControlPacket& s) { c1_state = s.desired_state; });
+    c2.set_on_state_control([&](const StateControlPacket& s) { c2_state = s.desired_state; });
+
+    SessionSnapshot s1;
+    s1.session_id = "slot01";
+    s1.character_name = "TankOne";
+    s1.server_name = "EZ";
+    s1.class_short = "WAR";
+    s1.level = 75;
+    s1.zone_short = "potimeb";
+    s1.hp_pct = 98;
+    s1.exec_state = app::ExecutionState::ForegroundFull;
+
+    SessionSnapshot s2;
+    s2.session_id = "slot02";
+    s2.character_name = "ClericTwo";
+    s2.server_name = "EZ";
+    s2.class_short = "CLR";
+    s2.level = 75;
+    s2.zone_short = "potimeb";
+    s2.hp_pct = 100;
+    s2.mana_pct = 85;
+    s2.exec_state = app::ExecutionState::BackgroundHeadless;
+
+    CHECK(c1.publish_telemetry(s1));
+    CHECK(c2.publish_telemetry(s2));
+    pump_all(srv, c1, c2, mgr);
+
+    // Controller (__manager__) must not appear as a game slot in roster().
+    const auto roster = srv.roster();
+    REQUIRE(roster.size() == 2);
+    CHECK(mgr.cached_roster().size() == 2);
+
+    // /bca from c1 -> delivers only to c2, never c1 or __manager__.
+    CommandPacket bca;
+    bca.scope = CommandScope::AllExceptSelf;
+    bca.sender_char = "TankOne";
+    bca.sender_zone = "potimeb";
+    bca.command = "/sit";
+    CHECK(c1.send_command(bca) > 0);
+    pump_all(srv, c1, c2, mgr);
+    CHECK(c1_cmds.empty());
+    REQUIRE(c2_cmds.size() == 1);
+    CHECK(c2_cmds[0] == "/sit");
+    CHECK(mgr_cmds.empty());
+    CHECK_FALSE(srv.take_acks().empty());
+
+    // Actor mailbox routing from c1 -> ClericTwo.
+    ActorPacket ap;
+    ap.sender_session = "slot01";
+    ap.sender_char = "TankOne";
+    ap.mailbox = "combat_mode";
+    ap.target_char = "ClericTwo";
+    ap.payload_json = R"({"heal":true,"hp":42})";
+    CHECK(c1.send_actor(ap));
+    pump_all(srv, c1, c2, mgr);
+    REQUIRE(c2_actors.size() == 1);
+    CHECK(c2_actors[0].mailbox == "combat_mode");
+    CHECK(c2_actors[0].payload_json == ap.payload_json);
+
+    // Exclusive foreground switch via manager client -> ClericTwo becomes FG, TankOne becomes BG_HEADLESS.
+    CHECK(mgr.request_switch_foreground("ClericTwo"));
+    pump_all(srv, c1, c2, mgr);
+    CHECK(c1_state == app::ExecutionState::BackgroundHeadless);
+    CHECK(c2_state == app::ExecutionState::ForegroundFull);
+
+    c1.disconnect();
+    c2.disconnect();
+    mgr.disconnect();
+    srv.stop();
+}
+#endif
diff --git a/tools/hailstone24_manager/broker_main.cpp b/tools/hailstone24_manager/broker_main.cpp
new file mode 100644
index 0000000..d8fd094
--- /dev/null
+++ b/tools/hailstone24_manager/broker_main.cpp
@@ -0,0 +1,493 @@
+// Hailstone 24 Session Broker & Child Process Supervisor.
+// Runs the local AF_UNIX IPC hub (hailstone::ipc::SessionBusServer), optionally imports MacroQuest
+// AutoLogin credentials into Hailstone's isolated data directory/keyring, and supervises up to 24
+// independent Hailstone client processes (1 foreground, 23 headless background).
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <format>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+#if !defined(_WIN32)
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+
+#include "app/execution_state.h"
+#include "core/group_profile.h"
+#include "core/ini_file.h"
+#include "core/mq_login_import.h"
+#include "core/wipe.h"
+#include "ipc/session_bus.h"
+#include "platform/paths.h"
+
+namespace fs = std::filesystem;
+using namespace hailstone;
+
+namespace {
+
+std::atomic<bool> g_stop_requested{false};
+
+void handle_signal(int) {
+    g_stop_requested.store(true, std::memory_order_relaxed);
+}
+
+struct RosterSlot {
+    int slot_number = 1;
+    int launch_order = 1;
+    std::string section;
+    bool enabled = true;
+    std::string session_id;
+    std::string server_id;
+    std::string world;
+    std::string account;
+    std::string character;
+    std::string class_role;
+    std::string settings_path;
+    std::string group_leader;
+    bool auto_login = true;
+    bool headless = true;
+    bool auto_kick = true;
+    int bg_tick_hz = 0;
+    std::string gpu_mode;
+};
+
+struct SupervisedChild {
+#if !defined(_WIN32)
+    pid_t pid = -1;
+#endif
+    std::string session_id;
+    std::string character;
+    bool running = false;
+};
+
+struct BrokerOptions {
+    std::string socket_path;
+    fs::path data_dir;
+    fs::path game_dir;
+    fs::path roster_path;
+    std::string profile_arg;
+    fs::path hailstone_bin;
+    fs::path gpu_broker_bin;
+    fs::path import_mq_path;
+    std::string mq_master_pass;
+    std::string server_override;
+    std::string world_override;
+    std::string gpu_mode = "cached";
+    int bg_tick_hz = 25;
+    int stagger_ms = 350;
+    int status_interval_s = 15;
+    bool launch_all = false;
+    bool shared_gpu = false;
+    bool exit_when_empty = false;
+};
+
+void usage() {
+    std::printf(
+        "usage: hailstone24_broker [options]\n"
+        "  --socket PATH             local AF_UNIX bus socket (default: $XDG_RUNTIME_DIR/hailstone24/bus.sock)\n"
+        "  --data-dir DIR            isolated Hailstone data directory for all 24 sessions\n"
+        "  --game-dir DIR            read-only EverQuest RoF2 game directory forwarded to clients\n"
+        "  --profile NAME_OR_PATH    group profile id/name/file in profiles/ (.ini or .json) to launch\n"
+        "  --roster PATH             hailstone24_roster.ini file listing slot01..slot24\n"
+        "  --hailstone-bin PATH      path to hailstone client executable (default: sibling hailstone)\n"
+        "  --import-mq-logins PATH   import MQ login.db / MQ2AutoLogin.ini into isolated keyring & write roster/profiles\n"
+        "  --mq-master-pass PASS     optional MacroQuest login.db master password (also $MQ_MASTER_PASSWORD)\n"
+        "  --server ID_OR_NAME       override login server profile id/name for import and launches\n"
+        "  --world NAME_OR_KEYWORD   override world server name, id, or unique keyword filter for launches\n"
+        "  --launch-all              stagger-launch enabled slots in (launch_order, slot_number) order\n"
+        "  --bg-tick-hz N            override background simulation Hz (10..60, default 25)\n"
+        "  --gpu-mode MODE           deferred | cached | shared-broker (default: cached)\n"
+        "  --shared-gpu              set --gpu-mode shared-broker and start hailstone_gpu_cache_broker if present\n"
+        "  --stagger-ms N            delay in ms between launching child clients (default 350)\n"
+        "  --status-interval-s N     periodic telemetry summary interval in seconds (0 = quiet, default 15)\n"
+        "  --exit-when-empty         exit automatically once launched children all exit\n"
+        "  -h, --help                show this help\n");
+}
+
+BrokerOptions parse_args(int argc, char** argv) {
+    BrokerOptions o;
+    if (const char* env_data = std::getenv("HAILSTONE_DATA_DIR"); env_data && *env_data) {
+        o.data_dir = env_data;
+    }
+    if (const char* env_pw = std::getenv("MQ_MASTER_PASSWORD"); env_pw && *env_pw) {
+        o.mq_master_pass = env_pw;
+    }
+    for (int i = 1; i < argc; ++i) {
+        const std::string_view a = argv[i];
+        auto need = [&]() -> const char* {
+            if (i + 1 >= argc) {
+                std::fprintf(stderr, "Missing value for %s\n", argv[i]);
+                std::exit(2);
+            }
+            return argv[++i];
+        };
+        if (a == "--socket") o.socket_path = need();
+        else if (a == "--data-dir") o.data_dir = need();
+        else if (a == "--game-dir") o.game_dir = need();
+        else if (a == "--profile") o.profile_arg = need();
+        else if (a == "--roster") o.roster_path = need();
+        else if (a == "--hailstone-bin") o.hailstone_bin = need();
+        else if (a == "--import-mq-logins") o.import_mq_path = need();
+        else if (a == "--mq-master-pass") o.mq_master_pass = need();
+        else if (a == "--server") o.server_override = need();
+        else if (a == "--world") o.world_override = need();
+        else if (a == "--gpu-mode") o.gpu_mode = need();
+        else if (a == "--bg-tick-hz") o.bg_tick_hz = std::clamp(std::atoi(need()), 10, 60);
+        else if (a == "--stagger-ms") o.stagger_ms = std::clamp(std::atoi(need()), 0, 10000);
+        else if (a == "--status-interval-s") o.status_interval_s = std::max(0, std::atoi(need()));
+        else if (a == "--launch-all") o.launch_all = true;
+        else if (a == "--shared-gpu") {
+            o.shared_gpu = true;
+            o.gpu_mode = "shared-broker";
+        } else if (a == "--exit-when-empty") {
+            o.exit_when_empty = true;
+        } else if (a == "--help" || a == "-h") {
+            usage();
+            std::exit(0);
+        } else {
+            std::fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            std::exit(2);
+        }
+    }
+    return o;
+}
+
+std::vector<RosterSlot> load_roster(const BrokerOptions& opts, fs::path& used_profile_path,
+                                    std::string& load_error) {
+    std::vector<RosterSlot> out;
+    fs::path source_path;
+    bool using_group_profile = false;
+
+    if (!opts.profile_arg.empty()) {
+        auto found = core::find_group_profile_file(platform::profiles_dir(), opts.profile_arg);
+        if (!found) {
+            load_error = std::format("Group profile '{}' not found in {}", opts.profile_arg,
+                                     platform::profiles_dir().string());
+            return out;
+        }
+        source_path = *found;
+        using_group_profile = true;
+    } else {
+        source_path = opts.roster_path;
+    }
+
+    core::GroupProfile gp;
+    if (!core::load_group_profile(source_path, gp, &load_error)) {
+        return out;
+    }
+    if (using_group_profile) used_profile_path = gp.source_path;
+
+    for (const auto& s : gp.slots) {
+        if (!s.enabled || s.account.empty()) continue;
+        RosterSlot slot;
+        slot.slot_number = s.slot_number;
+        slot.launch_order = s.launch_order;
+        slot.section = std::format("slot{:02d}", s.slot_number);
+        slot.enabled = s.enabled;
+        slot.session_id = s.session_id;
+        slot.server_id = !opts.server_override.empty()
+                             ? opts.server_override
+                             : (!s.server_id.empty() ? s.server_id : gp.default_server_id);
+        slot.world = !opts.world_override.empty()
+                         ? opts.world_override
+                         : (!s.world.empty() ? s.world : gp.default_world);
+        slot.account = s.account;
+        slot.character = s.character;
+        slot.class_role = s.class_role;
+        slot.auto_login = s.auto_login;
+        slot.headless = s.headless;
+        slot.auto_kick = s.auto_kick;
+        slot.bg_tick_hz = s.bg_tick_hz > 0 ? s.bg_tick_hz : opts.bg_tick_hz;
+        slot.gpu_mode = s.gpu_mode.empty() ? opts.gpu_mode : s.gpu_mode;
+        slot.group_leader = s.group_leader;
+        if (auto eff = core::resolve_effective_settings_path(platform::data_dir(), gp, s)) {
+            slot.settings_path = eff->string();
+        }
+        out.push_back(std::move(slot));
+        if (out.size() >= 24) break;
+    }
+    return out;
+}
+
+#if !defined(_WIN32)
+pid_t spawn_process(const std::vector<std::string>& args) {
+    if (args.empty()) return -1;
+    std::vector<char*> c_args;
+    c_args.reserve(args.size() + 1);
+    for (const auto& s : args) c_args.push_back(const_cast<char*>(s.c_str()));
+    c_args.push_back(nullptr);
+
+    const pid_t pid = ::fork();
+    if (pid < 0) return -1;
+    if (pid == 0) {
+        ::execvp(c_args[0], c_args.data());
+        std::fprintf(stderr, "execvp(%s) failed: %s\n", c_args[0], std::strerror(errno));
+        ::_exit(127);
+    }
+    return pid;
+}
+
+void terminate_children(std::vector<SupervisedChild>& children, pid_t& gpu_pid) {
+    for (const auto& c : children) {
+        if (c.running && c.pid > 0) ::kill(c.pid, SIGTERM);
+    }
+    if (gpu_pid > 0) ::kill(gpu_pid, SIGTERM);
+
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (std::chrono::steady_clock::now() < deadline) {
+        bool any_alive = false;
+        for (auto& c : children) {
+            if (!c.running || c.pid <= 0) continue;
+            int status = 0;
+            const pid_t r = ::waitpid(c.pid, &status, WNOHANG);
+            if (r == c.pid) {
+                c.running = false;
+            } else {
+                any_alive = true;
+            }
+        }
+        if (gpu_pid > 0) {
+            int status = 0;
+            if (::waitpid(gpu_pid, &status, WNOHANG) == gpu_pid) {
+                gpu_pid = -1;
+            } else {
+                any_alive = true;
+            }
+        }
+        if (!any_alive) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    }
+
+    for (auto& c : children) {
+        if (c.running && c.pid > 0) {
+            ::kill(c.pid, SIGKILL);
+            int status = 0;
+            ::waitpid(c.pid, &status, 0);
+            c.running = false;
+        }
+    }
+    if (gpu_pid > 0) {
+        ::kill(gpu_pid, SIGKILL);
+        int status = 0;
+        ::waitpid(gpu_pid, &status, 0);
+        gpu_pid = -1;
+    }
+}
+#endif
+
+} // namespace
+
+int main(int argc, char** argv) {
+    BrokerOptions opts = parse_args(argc, argv);
+
+    if (!opts.data_dir.empty()) {
+        std::error_code ec;
+        fs::create_directories(opts.data_dir, ec);
+        platform::use_data_dir(opts.data_dir, "--data-dir");
+    }
+    if (opts.socket_path.empty()) opts.socket_path = ipc::default_bus_socket_path();
+    if (opts.roster_path.empty()) opts.roster_path = platform::data_dir() / "hailstone24_roster.ini";
+
+    if (opts.hailstone_bin.empty()) {
+        fs::path self_dir = platform::install_dir();
+        fs::path candidate = self_dir / "hailstone";
+        if (fs::exists(candidate)) opts.hailstone_bin = candidate;
+        else opts.hailstone_bin = "hailstone";
+    }
+    if (opts.gpu_broker_bin.empty()) {
+        fs::path candidate = platform::install_dir() / "hailstone_gpu_cache_broker";
+        if (fs::exists(candidate)) opts.gpu_broker_bin = candidate;
+    }
+
+    if (!opts.import_mq_path.empty()) {
+        core::MqImportOptions imp;
+        imp.source_path = opts.import_mq_path;
+        imp.master_password = opts.mq_master_pass;
+        imp.target_server_id = opts.server_override;
+        imp.servers_dir = platform::servers_dir();
+        imp.roster_out = opts.roster_path;
+        imp.profiles_dir = platform::profiles_dir();
+        imp.write_group_profiles = true;
+        const auto res = core::import_mq_logins(imp);
+        core::wipe(imp.master_password);
+        core::wipe(opts.mq_master_pass);
+        if (!res.ok) {
+            std::fprintf(stderr, "[broker] MQ login import failed (%s): %s\n",
+                         res.source_kind.c_str(), res.error.c_str());
+            return 1;
+        }
+        std::printf("[broker] Imported %zu/%zu MQ logins (%zu keyring passwords, %zu characters, %zu profiles) -> %s\n",
+                    res.accounts_imported, res.accounts_found, res.passwords_saved, res.characters_linked,
+                    res.group_profiles_written.size(), opts.roster_path.string().c_str());
+        for (const auto& w : res.warnings) std::printf("[broker] warning: %s\n", w.c_str());
+    }
+    core::wipe(opts.mq_master_pass);
+
+    std::signal(SIGINT, handle_signal);
+    std::signal(SIGTERM, handle_signal);
+#if !defined(_WIN32)
+    std::signal(SIGPIPE, SIG_IGN);
+#endif
+
+    ipc::SessionBusServer bus;
+    if (!bus.start(opts.socket_path)) {
+        std::fprintf(stderr, "[broker] Failed to bind session IPC socket: %s\n", opts.socket_path.c_str());
+        return 1;
+    }
+    std::printf("[broker] Listening on %s (data-dir=%s)\n",
+                opts.socket_path.c_str(), platform::data_dir().string().c_str());
+    std::fflush(stdout);
+
+    std::vector<SupervisedChild> children;
+#if !defined(_WIN32)
+    pid_t gpu_broker_pid = -1;
+    if (opts.shared_gpu && !opts.gpu_broker_bin.empty() && fs::exists(opts.gpu_broker_bin)) {
+        gpu_broker_pid = spawn_process({opts.gpu_broker_bin.string(), "--serve"});
+        if (gpu_broker_pid > 0) {
+            std::printf("[broker] Started hailstone_gpu_cache_broker (pid=%d)\n", static_cast<int>(gpu_broker_pid));
+        }
+    }
+
+    if (opts.launch_all) {
+        fs::path profile_path;
+        std::string load_error;
+        const auto slots = load_roster(opts, profile_path, load_error);
+        if (slots.empty()) {
+            std::fprintf(stderr, "[broker] --launch-all set but no enabled slots loaded (%s)\n",
+                         load_error.empty() ? opts.roster_path.string().c_str() : load_error.c_str());
+        }
+        for (std::size_t idx = 0; idx < slots.size() && !g_stop_requested.load(std::memory_order_relaxed); ++idx) {
+            const auto& slot = slots[idx];
+            std::vector<std::string> args;
+            args.push_back(opts.hailstone_bin.string());
+            args.push_back("--data-dir");
+            args.push_back(platform::data_dir().string());
+            if (!opts.game_dir.empty()) {
+                args.push_back("--game-dir");
+                args.push_back(opts.game_dir.string());
+            }
+            if (!profile_path.empty()) {
+                args.push_back("--profile");
+                args.push_back(profile_path.string());
+                args.push_back("--slot");
+                args.push_back(std::to_string(slot.slot_number));
+            }
+            if (!slot.server_id.empty()) {
+                args.push_back("--server");
+                args.push_back(slot.server_id);
+            }
+            if (!slot.world.empty()) {
+                args.push_back("--world");
+                args.push_back(slot.world);
+            }
+            args.push_back("--account");
+            args.push_back(slot.account);
+            if (!slot.character.empty()) {
+                args.push_back("--character");
+                args.push_back(slot.character);
+            }
+            if (!slot.settings_path.empty()) {
+                args.push_back("--settings-path");
+                args.push_back(slot.settings_path);
+            }
+            if (slot.auto_login) args.push_back("--auto-login");
+            if (slot.auto_kick) args.push_back("--auto-kick");
+            args.push_back("--session-id");
+            args.push_back(slot.session_id);
+            args.push_back("--ipc-socket");
+            args.push_back(opts.socket_path);
+            args.push_back("--bg-tick-hz");
+            args.push_back(std::to_string(slot.bg_tick_hz));
+            args.push_back("--gpu-mode");
+            args.push_back(slot.gpu_mode);
+            if (slot.headless) args.push_back("--headless-bg");
+
+            const pid_t cpid = spawn_process(args);
+            if (cpid > 0) {
+                children.push_back(SupervisedChild{cpid, slot.session_id, slot.character, true});
+                std::printf("[broker] Launched order=%d slot=%d (%s) char=%s mode=%s (pid=%d)\n",
+                            slot.launch_order, slot.slot_number, slot.session_id.c_str(),
+                            slot.character.empty() ? "<select>" : slot.character.c_str(),
+                            slot.headless ? "BACKGROUND_HEADLESS" : "FOREGROUND_FULL",
+                            static_cast<int>(cpid));
+            } else {
+                std::fprintf(stderr, "[broker] Failed to spawn %s\n", slot.session_id.c_str());
+            }
+            if (idx + 1 < slots.size() && opts.stagger_ms > 0) {
+                bus.poll_once(opts.stagger_ms);
+            }
+        }
+        std::fflush(stdout);
+    }
+#endif
+
+    auto last_summary = std::chrono::steady_clock::now();
+    while (!g_stop_requested.load(std::memory_order_relaxed)) {
+        bus.poll_once(20);
+        (void)bus.take_acks();
+
+#if !defined(_WIN32)
+        int active_children = 0;
+        for (auto& c : children) {
+            if (!c.running || c.pid <= 0) continue;
+            int status = 0;
+            const pid_t r = ::waitpid(c.pid, &status, WNOHANG);
+            if (r == c.pid) {
+                c.running = false;
+                const int code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+                std::printf("[broker] Child %s (%s) exited (status=%d)\n",
+                            c.session_id.c_str(), c.character.c_str(), code);
+                std::fflush(stdout);
+            } else {
+                ++active_children;
+            }
+        }
+        if (opts.exit_when_empty && !children.empty() && active_children == 0) {
+            std::printf("[broker] All launched sessions exited; stopping.\n");
+            break;
+        }
+#endif
+
+        if (opts.status_interval_s > 0) {
+            const auto now = std::chrono::steady_clock::now();
+            if (now - last_summary >= std::chrono::seconds(opts.status_interval_s)) {
+                last_summary = now;
+                const auto roster = bus.roster();
+                std::uint64_t total_rss_mib = 0;
+                std::uint64_t total_vram_mib = 0;
+                std::string fg = "none";
+                for (const auto& s : roster) {
+                    total_rss_mib += s.rss_mib;
+                    total_vram_mib += s.vram_mib;
+                    if (s.exec_state == app::ExecutionState::ForegroundFull) {
+                        fg = s.character_name.empty() ? s.session_id : s.character_name;
+                    }
+                }
+                std::printf("[broker] Connected=%zu/24 Foreground=%s RSS=%llu MiB EstVRAM=%llu MiB\n",
+                            roster.size(), fg.c_str(),
+                            static_cast<unsigned long long>(total_rss_mib),
+                            static_cast<unsigned long long>(total_vram_mib));
+                std::fflush(stdout);
+            }
+        }
+    }
+
+#if !defined(_WIN32)
+    terminate_children(children, gpu_broker_pid);
+#endif
+    bus.stop();
+    std::printf("[broker] Shutdown complete.\n");
+    return 0;
+}
