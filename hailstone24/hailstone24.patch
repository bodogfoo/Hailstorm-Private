+// ---------------------------------------------------------------- Sandbox path & quota guards
+
+enum class PathAccess { Read, Write };
+
+std::string ascii_lower_trim_part(std::string_view s) {
+    while (!s.empty() && (s.back() == '.' || s.back() == ' ')) s.remove_suffix(1);
+    std::string out(s);
+    for (char& c : out) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return out;
+}
+
+bool is_config_segment(const fs::path& rel) {
+    if (rel.empty()) return false;
+    return ascii_lower_trim_part(rel.begin()->generic_string()) == "config";
+}
+
+bool check_under_root(const fs::path& root, const fs::path& given_path, bool allow_root, bool reject_config_subdir,
+                      fs::path& out) {
+    if (root.empty()) return false;
+    std::error_code ec;
+    fs::path canon_root = fs::weakly_canonical(root, ec);
+    if (ec || canon_root.empty()) canon_root = root.lexically_normal();
+
+    fs::path cand = given_path.is_relative() ? (canon_root / given_path) : given_path;
+    fs::path canon_cand = fs::weakly_canonical(cand, ec);
+    if (ec) return false;
+
+    fs::path rel = canon_cand.lexically_relative(canon_root);
+    if (rel == "." || canon_cand == canon_root) {
+        if (!allow_root) return false;
+        out = std::move(canon_cand);
+        return true;
+    }
+    if (rel.empty() || rel.is_absolute()) return false;
+    if (*rel.begin() == "..") return false;
+    if (reject_config_subdir && is_config_segment(rel)) return false;
+    out = std::move(canon_cand);
+    return true;
+}
+
+bool starts_with_icase(std::string_view s, std::string_view prefix) {
+    if (s.size() < prefix.size()) return false;
+    for (std::size_t i = 0; i < prefix.size(); ++i) {
+        const auto a = static_cast<unsigned char>(std::tolower(static_cast<unsigned char>(s[i])));
+        const auto b = static_cast<unsigned char>(std::tolower(static_cast<unsigned char>(prefix[i])));
+        if (a != b) return false;
+    }
+    return true;
+}
+
+std::optional<fs::path> resolve_sandbox_path(lua_State* L, std::string_view given, PathAccess access, bool allow_root,
+                                             std::string& why) {
+    if (given.empty() || given.find('\0') != std::string_view::npos) {
+        why = "invalid path";
+        return std::nullopt;
+    }
+    CompatHolder* h = get_compat(L);
+    if (!h) {
+        why = "sandbox environment unavailable";
+        return std::nullopt;
+    }
+    if (access == PathAccess::Write && h->env.write_blocked && h->env.write_blocked()) {
+        why = "write blocked while dry-running or stopping";
+        return std::nullopt;
+    }
+
+    std::string norm(given);
+#if !defined(_WIN32)
+    std::replace(norm.begin(), norm.end(), '\\', '/');
+#endif
+    fs::path gp(norm);
+    fs::path resolved;
+    if (access == PathAccess::Write) {
+        if (check_under_root(h->env.config_dir, gp, allow_root, false, resolved)) {
+            return resolved;
+        }
+        why = "write path is outside Hailstone mq.configDir";
+        return std::nullopt;
+    }
+
+    std::vector<fs::path> ro_roots;
+    if (!h->env.script_root.empty()) ro_roots.push_back(h->env.script_root);
+    for (const auto& d : h->env.read_dirs) {
+        if (!d.empty()) ro_roots.push_back(d);
+    }
+
+    auto find_in_ro_roots = [&](bool require_exists) -> std::optional<fs::path> {
+        std::error_code ec;
+        for (const auto& r : ro_roots) {
+            fs::path cand;
+            if (check_under_root(r, gp, allow_root, true, cand) && (!require_exists || fs::exists(cand, ec))) {
+                return cand;
+            }
+            if (gp.is_relative() && starts_with_icase(norm, "scripts/")) {
+                fs::path scripts_name = r.filename();
+                if (ascii_lower_trim_part(scripts_name.generic_string()) == "scripts") {
+                    const fs::path stripped(norm.substr(8));
+                    if (check_under_root(r, stripped, allow_root, true, cand) &&
+                        (!require_exists || fs::exists(cand, ec))) {
+                        return cand;
+                    }
+                }
+            }
+        }
+        return std::nullopt;
+    };
+
+    if (gp.is_relative()) {
+        std::error_code ec;
+        const bool explicit_class_cfg = starts_with_icase(norm, "class_configs/") ||
+                                        starts_with_icase(norm, "rgmercs/class_configs/") ||
+                                        starts_with_icase(norm, "scripts/rgmercs/class_configs/");
+        if (explicit_class_cfg) {
+            if (auto cand = find_in_ro_roots(true)) return cand;
+            // Even when missing, do not route relative class_configs/ paths to scripts/config/.
+            why = "class config path not found in trusted script root";
+            return std::nullopt;
+        }
+        if (check_under_root(h->env.config_dir, gp, allow_root, false, resolved) && fs::exists(resolved, ec)) {
+            return resolved;
+        }
+        if (auto cand = find_in_ro_roots(true)) return cand;
+        if (check_under_root(h->env.config_dir, gp, allow_root, false, resolved)) {
+            return resolved;
+        }
+    } else {
+        if (check_under_root(h->env.config_dir, gp, allow_root, false, resolved)) {
+            return resolved;
+        }
+        if (auto cand = find_in_ro_roots(false)) return cand;
+    }
+
+    why = "path is outside Hailstone sandbox";
+    return std::nullopt;
+}
