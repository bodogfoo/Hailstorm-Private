+        if (n < 0) {
+            if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) continue;
+            return false;
+        }
+        if (n == 0) return false;
+        offset += static_cast<std::size_t>(n);
+    }
+    return true;
+}
