+int l_sqlite_stmt_gc(lua_State* L) {
+    auto* st = static_cast<LuaSqliteStmt*>(lua_touserdata(L, 1));
+    if (st) {
+        if (st->owner) {
+            std::erase(st->owner->stmts, st);
+            st->owner = nullptr;
+        }
+        st->finish();
+    }
+    return 0;
+}
