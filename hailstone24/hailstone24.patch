+    PackageMan.InstallAndLoad = PackageMan.Require
+    function PackageMan.Install() return true end
+    function PackageMan.Update() return true end
+    function PackageMan.Check(...)
+        local candidates = resolve_candidates(...)
+        for _, target in ipairs(candidates) do
+            local ok, mod = pcall(require, target)
+            if ok and mod ~= nil then return true end
+        end
+        return false
+    end
+    preloaded['mq.PackageMan'] = PackageMan
+    preloaded['PackageMan'] = PackageMan
+end
