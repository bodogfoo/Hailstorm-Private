+std::string normalize_settings_for_storage(std::string_view raw) {
+    if (raw.empty()) return {};
+    const fs::path p(raw);
+    if (has_dotdot_component(p)) return {};
+    if (p.is_absolute()) {
+        return p.lexically_normal().generic_string();
+    }
+    return p.lexically_normal().generic_string();
+}
