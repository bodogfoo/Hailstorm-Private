+        {"lines", l_io_lines},
+        {"flush", l_io_flush},
+        {"write", l_io_write},
+        {"read", l_io_disabled},
+        {"input", l_io_disabled},
+        {"output", l_io_disabled},
+        {nullptr, nullptr},
+    };
+    luaL_newlib(L, kIoFuncs);
+    return 1;
