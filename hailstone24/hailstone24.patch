+void push_cell(lua_State* L, const ui::UiTextures::Cell& c) {
+    lua_pushlightuserdata(L, c.id);
+    lua_pushnumber(L, c.u0);
+    lua_pushnumber(L, c.v0);
+    lua_pushnumber(L, c.u1);
+    lua_pushnumber(L, c.v1);
