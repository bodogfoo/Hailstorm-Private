diff --git a/tests/hailstone24/execution_state_test.cpp b/tests/hailstone24/execution_state_test.cpp
new file mode 100644
index 0000000..a3c26ae
--- /dev/null
+++ b/tests/hailstone24/execution_state_test.cpp
@@ -0,0 +1,65 @@
+#include <doctest/doctest.h>
+
+#include <chrono>
+
+#include "app/execution_state.h"
+#include "app/frame_pace.h"
+
+using namespace hailstone::app;
+
+TEST_CASE("ExecutionController transitions and GPU/UI suppression flags") {
+    ExecutionController ctrl;
+    ctrl.configure(true, 25, GpuRetentionMode::WarmCache);
+    CHECK(ctrl.state() == ExecutionState::BackgroundHeadless);
+    CHECK(ctrl.is_headless());
+    CHECK_FALSE(ctrl.is_foreground());
+    CHECK_FALSE(ctrl.should_render());
+    CHECK(ctrl.should_suppress_gpu_and_ui());
+    CHECK(ctrl.background_tick_hz() == 25);
+    CHECK(ctrl.gpu_mode() == GpuRetentionMode::WarmCache);
+
+    const auto t0 = ExecutionController::Clock::now();
+    ctrl.request_foreground(t0);
+    CHECK(ctrl.state() == ExecutionState::Transitioning);
+    CHECK(ctrl.is_transitioning());
+    CHECK(ctrl.should_render());
+    CHECK_FALSE(ctrl.should_suppress_gpu_and_ui());
+
+    ctrl.complete_foreground_transition(t0 + std::chrono::milliseconds(18));
+    CHECK(ctrl.state() == ExecutionState::ForegroundFull);
+    CHECK(ctrl.is_foreground());
+    CHECK(ctrl.metrics().last_switch_ms == 18);
+
+    ctrl.enter_background_headless();
+    CHECK(ctrl.is_headless());
+    CHECK(ctrl.should_suppress_gpu_and_ui());
+
+    ctrl.set_background_tick_hz(5);
+    CHECK(ctrl.background_tick_hz() == 10);
+    ctrl.set_background_tick_hz(120);
+    CHECK(ctrl.background_tick_hz() == 60);
+}
+
+TEST_CASE("FramePace decouples background simulation Hz from visual rendering") {
+    const auto bg = frame_pace_for_state(
+        ExecutionState::BackgroundHeadless, 60, kBackgroundNoDraw, 25, false, std::chrono::seconds(5));
+    CHECK(bg.cap == 25);
+    CHECK_FALSE(bg.draw);
+    CHECK(bg.skip_ui_build);
+
+    const auto trans = frame_pace_for_state(
+        ExecutionState::Transitioning, 60, kBackgroundNoDraw, 25, false, std::chrono::milliseconds(0));
+    CHECK(trans.cap == 0);
+    CHECK(trans.draw);
+    CHECK_FALSE(trans.skip_ui_build);
+
+    const auto fg = frame_pace_for_state(
+        ExecutionState::ForegroundFull, 60, kBackgroundNoDraw, 25, true, std::chrono::milliseconds(0));
+    CHECK(fg.cap == 60);
+    CHECK(fg.draw);
+    CHECK_FALSE(fg.skip_ui_build);
+
+    CHECK(parse_gpu_retention_mode("deferred") == GpuRetentionMode::Deferred);
+    CHECK(parse_gpu_retention_mode("cached") == GpuRetentionMode::WarmCache);
+    CHECK(parse_gpu_retention_mode("shared-broker") == GpuRetentionMode::SharedBroker);
+}
diff --git a/tests/hailstone24/login_autoselect_test.cpp b/tests/hailstone24/login_autoselect_test.cpp
new file mode 100644
index 0000000..3229e6e
--- /dev/null
+++ b/tests/hailstone24/login_autoselect_test.cpp
@@ -0,0 +1,76 @@
+#include <doctest/doctest.h>
+
+#include <string>
+#include <vector>
+
+#include "app/login_launch.h"
+#include "core/server_profile.h"
+#include "net/login.h"
+#include "ui/dev_screens.h"
+
+using namespace hailstone;
+
+TEST_CASE("Login auto-select: resolve_world_target supports exact, key-part, and unique keyword matching") {
+    std::vector<net::ServerInfo> servers(3);
+    servers[0].id = 10;
+    servers[0].name = "Project 1999 (Green)";
+    servers[1].id = 25;
+    servers[1].name = "EZ (Linux) [RoF2]";
+    servers[2].id = 30;
+    servers[2].name = "Project Lazarus [RoF2]";
+
+    // Exact numeric id & exact case-insensitive name (same as launcher_world).
+    CHECK(app::resolve_world_target(servers, "25") == &servers[1]);
+    CHECK(app::resolve_world_target(servers, "ez (linux) [rof2]") == &servers[1]);
+
+    // Whitespace-trimmed / saved_character_key_part exact match.
+    const std::string key = saved_character_key_part(servers[1].name);
+    CHECK(app::resolve_world_target(servers, key) == &servers[1]);
+
+    // Multi-token keyword match uniquely selects EZ (Linux) [RoF2].
+    CHECK(app::resolve_world_target(servers, "ez linux") == &servers[1]);
+    CHECK(app::resolve_world_target(servers, "EZ rof2") == &servers[1]);
+
+    // Ambiguous keyword across multiple worlds refuses to guess.
+    CHECK(app::resolve_world_target(servers, "rof2") == nullptr);
+    CHECK(app::resolve_world_target(servers, "project") == nullptr);
+
+    // Non-matching or empty selector.
+    CHECK(app::resolve_world_target(servers, "nonexistent") == nullptr);
+    CHECK(app::resolve_world_target(servers, "   ") == nullptr);
+
+    // Exact launcher_world remains strict so upstream semantics never drift.
+    CHECK(app::launcher_world(servers, "ez linux") == nullptr);
+    CHECK(app::resolve_world_target(servers, "ez linux", false) == nullptr);
+}
+
+TEST_CASE("Server select: keyword filter matches all whitespace tokens case-insensitively") {
+    ui::ServerEntry ez{"EZ (Linux) x2/x4 [RoF2]", "Up", true, true};
+    ui::ServerEntry p99{"Project 1999 Green", "Up", true, false};
+
+    CHECK(ui::server_matches_filter(ez, ""));
+    CHECK(ui::server_matches_filter(ez, "   \t "));
+    CHECK(ui::server_matches_filter(ez, "ez"));
+    CHECK(ui::server_matches_filter(ez, "rof2 ez linux"));
+    CHECK(ui::server_matches_filter(ez, "  EZ   x2  "));
+    CHECK_FALSE(ui::server_matches_filter(ez, "ez p99"));
+    CHECK_FALSE(ui::server_matches_filter(p99, "ez"));
+}
+
+TEST_CASE("Server select: favorite worlds trim whitespace and dedupe case-insensitively while pinning top") {
+    const auto parsed = ui::parse_favorite_worlds("  EZ Server | Project 1999 || ez server |  Laz  ");
+    CHECK(parsed == std::vector<std::string>{"EZ Server", "Project 1999", "Laz"});
+
+    const std::vector<std::string> names{
+        "Alpha World",
+        "Beta [RoF2]",
+        "EZ Server",
+        "Gamma",
+        "Zeta",
+    };
+    const auto order = ui::server_list_order(names, {"  ez server  ", "zeta"});
+    std::vector<std::string> sorted;
+    sorted.reserve(order.size());
+    for (std::size_t idx : order) sorted.push_back(names[idx]);
+    CHECK(sorted == std::vector<std::string>{"EZ Server", "Zeta", "Alpha World", "Beta [RoF2]", "Gamma"});
+}
diff --git a/tests/hailstone24/mq_login_import_test.cpp b/tests/hailstone24/mq_login_import_test.cpp
