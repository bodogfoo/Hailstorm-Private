+// done, total, mode, where = eq.ItemJob()   -- the job running (mode: "sort", "stack", "tidy", "sell", "destroy",
+// "tribute", "withdraw"; where:
+// "inventory", "bank" or "bag"); nil when none is
+int ItemJob(lua_State* L) {
