+struct Vec3 {
+    float x = 0.0f;
+    float y = 0.0f;
+    float z = 0.0f;
+
+    float distance_2d(const Vec3& o) const noexcept {
+        const float dx = x - o.x;
+        const float dy = y - o.y;
+        return std::sqrt(dx * dx + dy * dy);
+    }
+
+    float distance_3d(const Vec3& o) const noexcept {
