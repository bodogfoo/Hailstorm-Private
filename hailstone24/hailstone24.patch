+bool has_transition(const CombatStatusSnapshot& st, CombatState from, CombatState to) {
+    for (const auto& t : st.transitions) {
+        if (t.from_state == from && t.to_state == to && !t.reason.empty()) {
+            return true;
+        }
+    }
+    return false;
+}
