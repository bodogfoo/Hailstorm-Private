+// Pushes an overlay's text, r, g, b (eq.BuffOverlay's results), or four nils for none.
+void push_overlay(lua_State* L, const std::optional<game::BuffOverlayText>& o) {
+    if (!o) {
+        for (int k = 0; k < 4; ++k) lua_pushnil(L);
+        return;
