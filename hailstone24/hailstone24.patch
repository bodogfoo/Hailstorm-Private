+TEST_CASE("RGMercs Class Initialization: Stabbinyah (ROG male), Yavaha (WAR), Norosun (MAG), and Noro's Son (apostrophe caster)") {
+    struct CharCase {
+        const char* name;
+        std::uint8_t class_id;
+        const char* class_short;
+        std::uint8_t gender;
+        const char* expected_gender;
+    };
+    const CharCase cases[] = {
+        {"Stabbinyah", 9, "ROG", 0, "male"},
+        {"Yavaha", 1, "WAR", 0, "male"},
+        {"Norosun", 13, "MAG", 0, "male"},
+        {"Noro's Son", 12, "WIZ", 0, "male"},
+    };
+
+    for (const auto& tc : cases) {
+        LoaderHarness h;
+        using A = net::GameConnectionTestAccess;
+        A::character(*h.world.conn) = tc.name;
+        if (!A::profile(*h.world.conn)) A::profile(*h.world.conn).emplace();
+        A::profile(*h.world.conn)->class_ = tc.class_id;
+        auto& w = A::world(*h.world.conn);
+        w.spawns[1].name = tc.name;
+        w.spawns[1].class_id = tc.class_id;
+        w.spawns[1].gender = tc.gender;
+        h.bridge.attach_character(h.world.dir, h.char_dir, tc.name, "EZ Server", tc.class_short);
+
+        std::string cls_lower = tc.class_short;
+        std::transform(cls_lower.begin(), cls_lower.end(), cls_lower.begin(),
+                       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        write_file(h.lua_dir / "rgmercs" / "class_configs" / "Live" / (cls_lower + "_class_config.lua"), R"lua(
+local mq = require('mq')
+local hailstone = require('hailstone')
+local summary = string.format("%s|%s|%s|%s", mq.TLO.Me.Name(), mq.TLO.Me.Class.ShortName(), mq.TLO.Me.Gender(), mq.TLO.MacroQuest.Server())
+hailstone.rgmercs.set_module('Class', true, 'Running', summary)
+hailstone.rgmercs.set_status('ClassReady:' .. summary)
+return { summary = summary }
+)lua");
+
+        write_file(h.lua_dir / "rgmercs" / "init.lua", R"lua(
+local mq = require('mq')
+local cls = mq.TLO.Me.Class.ShortName():lower()
+local cfg = assert(dofile('class_configs/Live/' .. cls .. '_class_config.lua'))
+print('INIT:' .. cfg.summary)
+)lua");
+
+        std::string why;
+        REQUIRE(h.host->run("rgmercs", {}, &why));
+        for (int i = 0; i < 16 && h.host->running("rgmercs"); ++i) {
+            h.now_ms += 10;
+            h.host->pulse();
+        }
+        const std::string expected = std::string(tc.name) + "|" + tc.class_short + "|" + tc.expected_gender + "|EZ Server";
+        CHECK(h.has_line("INIT:" + expected));
+        const auto snap = h.bridge.snapshot();
+        CHECK(snap.last_error.empty());
+        CHECK(snap.runtime_state == "ClassReady:" + expected);
+    }
+}
