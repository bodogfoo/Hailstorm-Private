+        return s:lower():gsub('^%s+', ''):gsub('%s+$', '')
+    end
+    local function resolve_candidates(...)
+        local raw = { ... }
+        local start_idx = 1
+        if type(raw[1]) == 'table' then start_idx = 2 end
+        local args = {}
+        for i = start_idx, #raw do
+            if type(raw[i]) == 'string' and raw[i] ~= '' then
+                args[#args + 1] = raw[i]
+            end
+        end
+        local candidates = {}
+        local seen = {}
+        local function add(name)
+            if not name or name == '' or seen[name] then return end
+            seen[name] = true
+            candidates[#candidates + 1] = name
+            local mapped = aliases[norm_key(name)]
+            if mapped and not seen[mapped] then
+                seen[mapped] = true
+                candidates[#candidates + 1] = mapped
+            end
+        end
+        -- MQ PackageMan.Require(url_or_repo, pkg_name, mod_name) OR Require(pkg_name, mod_name) OR Require(mod_name)
+        if #args >= 3 then
+            add(args[3])
+            add(args[2])
+            add(args[1])
+        elseif #args == 2 then
+            add(args[2])
+            add(args[1])
+        elseif #args == 1 then
+            add(args[1])
