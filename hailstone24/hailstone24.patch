+    CHECK_FALSE(is_path_within_root(data_dir, dir.path() / "outside.ini"));
+    CHECK_FALSE(is_path_within_root(data_dir, char_dir / ".." / ".." / ".." / ".." / "escape.ini"));
+
+    // Secret key validation
