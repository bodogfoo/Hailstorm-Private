+return { _version = 'TrustedLiveROG', DefaultConfig = { SneakAttack = true } }
+)lua");
+
+    // Create 0-byte, comment-only, and explicit `return nil` data files in scripts/config/
+    write_file(h.cfg_dir / "empty_zero.lua", "");
